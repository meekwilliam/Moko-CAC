            Daily Quest
          </p>
          <span class="dq-reset" id="dqResetLabel">Resets in —</span>
        </div>

        <!-- Single daily quest (injected by DailyQuests.render()) -->
        <div id="dqQuestSlot"></div>
      </div>

      <!-- Routine + Water side-by-side -->
      <div class="home-twin-row fade-item" style="animation-delay:.22s;">
      <!-- Daily Routine Card -->
      <div class="routine-card">
        <div class="routine-card-header">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="var(--text-dark)" opacity="0.7"><path d="M17 2a1 1 0 0 1 1 1v1h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2V3a1 1 0 0 1 2 0v1h8V3a1 1 0 0 1 1-1zM4 10v10h16V10H4zm8 5.5-3-2.5a1 1 0 0 0-1.32 1.5l3.65 3.04a1 1 0 0 0 1.34-.04l5-5a1 1 0 0 0-1.4-1.42L12 15.5z"/></svg>
          <p class="routine-card-title">Daily Routine</p>

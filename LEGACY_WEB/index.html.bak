        {icon:"💦", tag:"Mist", name:"Fragrance-Free Hydrating Mist", reason:"A quick hydration boost any time of day."},
        {icon:"leaf", tag:"Serum", name:"Centella Soothing Serum", reason:"Calms sensitivity while skin recovers."}
      ]
    }
  ];
  var currentProfile = null;
  var firstScanDone = true;
  var hasAccount = localStorage.getItem('skin_scan_has_account') === 'true';
  var signupTargetScreen = 'screen-dashboard';

  function getHomeScreenId(){ return 'screen-dashboard'; }

  function scoreColor(score){ return score>=80 ? '#1E9E6B' : score>=70 ? '#38bdf8' : '#C8790B'; }

  function getMetricIconSvg(label) {
    var key = (label || '').toLowerCase().trim();
    if (key.includes('hydration') || key.includes('moisture')) {
      return `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 22a7 7 0 0 0 7-7c0-4.3-7-13-7-13S5 10.7 5 15a7 7 0 0 0 7 7z"/></svg>`;
    }
    if (key.includes('texture') || key.includes('roughness') || key.includes('radiance') || key.includes('smoothness')) {
      return `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L15 9L22 12L15 15L12 22L9 15L2 12L9 9Z"/></svg>`;
    }
    if (key.includes('pores') || key.includes('acne') || key.includes('breakout') || key.includes('spot')) {
      return `<svg viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="10"/></svg>`;
    }
    if (key.includes('redness') || key.includes('calm') || key.includes('sensitivity') || key.includes('irritation')) {
      return `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`;
    }
    if (key.includes('oiliness') || key.includes('oil') || key.includes('sebum')) {
      return `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>`;
    }
    return `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 22a7 7 0 0 0 7-7c0-4.3-7-13-7-13S5 10.7 5 15a7 7 0 0 0 7 7z"/></svg>`;
  }

  function getProductIconSvg(tag, iconFallback) {
    var cleanTag = (tag || '').toLowerCase().trim();
    if (cleanTag.includes('cleanser') || cleanTag.includes('wash') || cleanTag.includes('soap')) {
      return `<svg viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="7" r="3"/><circle cx="6" cy="14" r="2"/><circle cx="18" cy="13" r="2.5"/><circle cx="11" cy="18" r="2"/></svg>`;
    }
    if (cleanTag.includes('moisturizer') || cleanTag.includes('cream') || cleanTag.includes('gel') || cleanTag.includes('lotion')) {
      return `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M5 11h14v8a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-8z"/><path d="M4 7h16v4H4z"/><path d="M12 4a3 3 0 0 0-3 3h6a3 3 0 0 0-3-3z"/></svg>`;
    }
    if (cleanTag.includes('serum') || cleanTag.includes('oil') || cleanTag.includes('dropper')) {
      return `<svg viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="9" width="12" height="12" rx="2"/><path d="M9 9V6h6v3M12 3v3"/></svg>`;
    }
    if (cleanTag.includes('sunscreen') || cleanTag.includes('spf') || cleanTag.includes('sun')) {
      return `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 3a1 1 0 0 1 1 1v1a1 1 0 1 1-2 0V4a1 1 0 0 1 1-1zm0 15a1 1 0 0 1 1 1v1a1 1 0 1 1-2 0v-1a1 1 0 0 1 1-1zM4 11h1a1 1 0 0 0 0 2H4a1 1 0 0 0 0-2zm15 0h1a1 1 0 0 0 0 2h-1a1 1 0 0 0 0-2zM5.636 4.636a1 1 0 0 1 1.414 0l.707.707a1 1 0 0 1-1.414 1.414l-.707-.707a1 1 0 0 1 0-1.414zm12.728 12.728a1 1 0 0 1 1.414 0l.707.707a1 1 0 0 1-1.414 1.414l-.707-.707a1 1 0 0 1 0-1.414zm0-12.728a1 1 0 0 1 0 1.414l-.707.707a1 1 0 0 1-1.414-1.414l.707-.707a1 1 0 0 1 1.414 0zM6.343 17.657a1 1 0 0 1 0 1.414l-.707.707a1 1 0 0 1-1.414-1.414l.707-.707a1 1 0 0 1 1.414 0zM12 7a5 5 0 1 1 0 10A5 5 0 0 1 12 7z"/></svg>`;
    }
    if (cleanTag.includes('mist') || cleanTag.includes('spray')) {
      return `<svg viewBox="0 0 24 24" fill="currentColor"><rect x="7" y="10" width="10" height="11" rx="2"/><path d="M9 9V4h6v5H9zM19 6h-2v1h2V6zM18 8h-1v1h1V8z"/></svg>`;
    }
    if (cleanTag.includes('exfoliant') || cleanTag.includes('scrub') || cleanTag.includes('peel')) {
      return `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L15 9L22 12L15 15L12 22L9 15L2 12L9 9Z"/></svg>`;
    }
    if (cleanTag.includes('toner')) {
      return `<svg viewBox="0 0 24 24" fill="currentColor"><rect x="8" y="8" width="8" height="13" rx="2"/><path d="M10 4h4v4h-4z"/></svg>`;
    }
    if (cleanTag.includes('mask')) {
      return `<svg viewBox="0 0 24 24" fill="currentColor"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8" cy="10" r="1.5" fill="var(--bg-card)"/><circle cx="16" cy="10" r="1.5" fill="var(--bg-card)"/></svg>`;
    }
    if (cleanTag.includes('eye') || cleanTag.includes('under-eye')) {
      return `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M2 12s4-8 10-8 10 8 10 8-4 8-10 8-10-8-10-8z"/><circle cx="12" cy="12" r="3" fill="var(--bg-card)"/></svg>`;
    }
    if (cleanTag.includes('treatment') || cleanTag.includes('spot') || cleanTag.includes('acne')) {
      return `<svg viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="10"/></svg>`;
    }
    return iconFallback || `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>`;
  }

  /* ---------- Navigation ---------- */
  var bottomNav = document.getElementById('bottomNav');
  var NO_NAV_SCREENS = ['screen-splash', 'screen-signup'];

  function updateNavBar(toId){
    bottomNav.style.display = NO_NAV_SCREENS.indexOf(toId) > -1 ? 'none' : 'flex';
    document.querySelectorAll('.nav-item[data-screen]').forEach(function(btn){
      var screenId = btn.dataset.screen;
      var isActive = (screenId === toId);
      btn.classList.toggle('active', isActive);
    });
  }

  function navigate(toId, direction){
    // Guard: redirect to signup if trying to enter main app screens without an account
    var mainScreens = ['screen-dashboard', 'screen-progress', 'screen-profile'];
    if (!hasAccount && mainScreens.indexOf(toId) > -1) {
      signupTargetScreen = toId;
      toId = 'screen-signup';
    }

    var fromEl = document.querySelector('.screen.active');
    var toEl = document.getElementById(toId);
    if(!toEl){ return; }
    if(!fromEl){
      toEl.classList.add('active');
      toEl.style.transition = 'none';
      void toEl.offsetHeight;
      toEl.style.transition = '';
      if(toId === 'screen-dashboard'){ initDashboard(); }
      if(toId === 'screen-progress'){ renderProgressScreen(); SubscriptionManager.applySubscriptionUI(); setTimeout(function(){ if(window._updateFloatBanner) window._updateFloatBanner(); }, 50); setTimeout(function(){ if(window._openFirstLessonTooltip) window._openFirstLessonTooltip(); }, 60); setTimeout(function(){ if(window._drawSnakeTrail) window._drawSnakeTrail(); }, 150); }
      if(toId === 'screen-profile'){ renderProfileScreen(); }
      updateNavBar(toId);
      toEl.scrollTop = 0;
      return;
    }
    
    if(fromEl === toEl){ updateNavBar(toId); return; }
    
    // Global transition cleanup: prevent overlapping states
    document.querySelectorAll('.screen').forEach(function(s) {
      if (s !== fromEl && s !== toEl) {
        s.classList.remove('active', 'exiting', 'enter-right', 'enter-left', 'enter-fade', 'exit-left', 'exit-right', 'exit-fade');
        s.style.transition = 'none';
      }
    });

    // Determine slide direction for tabs based on screen order
    var SCREEN_ORDER = ['screen-splash', 'screen-dashboard', 'screen-progress', 'screen-profile'];
    var fromIdx = SCREEN_ORDER.indexOf(fromEl ? fromEl.id : '');
    var toIdx = SCREEN_ORDER.indexOf(toId);
    
    if (direction === 'tab' || direction === 'fade') {
      if (fromIdx > -1 && toIdx > -1) {
        direction = toIdx > fromIdx ? 'forward' : 'back';
      } else {
        direction = 'forward';
      }
    } else {
      direction = direction || 'forward';
    }

    toEl.style.transition = 'none';
    toEl.classList.remove('enter-right','enter-left','enter-fade','exit-left','exit-right','exit-fade');
    if(direction === 'forward'){ toEl.classList.add('enter-right'); }
    else if(direction === 'back'){ toEl.classList.add('enter-left'); }
    toEl.classList.add('active');
    void toEl.offsetHeight;

    if(fromEl){
      fromEl.classList.remove('active');
      fromEl.classList.add('exiting');
      if(direction === 'forward'){ fromEl.classList.add('exit-left'); }
      else if(direction === 'back'){ fromEl.classList.add('exit-right'); }
    }

    requestAnimationFrame(function(){
      requestAnimationFrame(function(){
        toEl.style.transition = '';
        toEl.classList.remove('enter-right','enter-left');

        // Defer heavy render work until animation is already running
        if(toId === 'screen-dashboard'){ initDashboard(); }
        if(toId === 'screen-progress'){ renderProgressScreen(); SubscriptionManager.applySubscriptionUI(); setTimeout(function(){ if(window._updateFloatBanner) window._updateFloatBanner(); }, 50); setTimeout(function(){ if(window._openFirstLessonTooltip) window._openFirstLessonTooltip(); }, 60); setTimeout(function(){ if(window._drawSnakeTrail) window._drawSnakeTrail(); }, 150); }
        if(toId === 'screen-profile'){ renderProfileScreen(); }
      });
    });

    if (window.navTimeout) { clearTimeout(window.navTimeout); }

    window.navTimeout = setTimeout(function(){
      if(fromEl){
        fromEl.classList.remove('exiting','exit-left','exit-right');
      }
    }, 360);

    updateNavBar(toId);
    toEl.scrollTop = 0;
  }

  document.querySelectorAll('.nav-item[data-screen]').forEach(function(btn){
    btn.addEventListener('click', function(){
      if (window.webkit && window.webkit.messageHandlers && window.webkit.messageHandlers.hapticSelection) {
        window.webkit.messageHandlers.hapticSelection.postMessage(null);
      }
      navigate(btn.dataset.screen, 'tab');
    });
  });
  var viewHistoryLink = document.getElementById('viewHistoryLink');
  if (viewHistoryLink) {
    viewHistoryLink.addEventListener('click', function(){ navigate('screen-progress','forward'); });
  }

  function completeSignup(name, email) {
    hasAccount = true;
    localStorage.setItem('skin_scan_has_account', 'true');
    localStorage.setItem('skin_scan_user_name', name);
    localStorage.setItem('skin_scan_user_email', email);
    localStorage.setItem('glowo_splash_seen', 'true');
    initDashboard();
    // Land new users on the Path / Learning Map (primary destination)
    navigate('screen-progress', 'forward');
  }

  document.getElementById('btnCreateAccount').addEventListener('click', function() {
    if (window.webkit && window.webkit.messageHandlers && window.webkit.messageHandlers.hapticSelection) {
      window.webkit.messageHandlers.hapticSelection.postMessage(null);
    }
    var nameVal = document.getElementById('signupName').value.trim() || 'Guest';
    completeSignup(nameVal, 'guest@email.com');
  });

  document.getElementById('btnSkipSignup').addEventListener('click', function() {
    if (window.webkit && window.webkit.messageHandlers && window.webkit.messageHandlers.hapticSelection) {
      window.webkit.messageHandlers.hapticSelection.postMessage(null);
    }
    completeSignup('Guest', 'guest@email.com');
  });

  /* Inject mascot into onboarding peek slot */
  (function() {
    var peekEl = document.getElementById('signup-mascot-peek');
    if (peekEl && typeof mascot === 'function') {
      peekEl.innerHTML = mascot('wink', 'signup');
      var svg = peekEl.querySelector('svg');
      if (svg) { svg.style.width = '86px'; svg.style.height = '86px'; }
    }
  })();

  /* ---------- Heart save toggle ---------- */
  document.querySelectorAll('.heart-btn').forEach(function(btn){
    btn.addEventListener('click', function(){
      var liked = btn.dataset.liked === '1';
      btn.innerHTML = liked
        ? '<svg width="16" height="16" viewBox="0 0 24 24" fill="var(--text-muted)" opacity="0.5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>'
        : '<svg width="16" height="16" viewBox="0 0 24 24" fill="var(--blue-primary)"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>';
      btn.dataset.liked = liked ? '0' : '1';
      btn.classList.remove('heart-pop');
      void btn.offsetWidth;
      btn.classList.add('heart-pop');
    });
  });

  /* ---------- Progress screen ---------- */

  /* ---------- Progress screen ---------- */
  var activeChartRange = 7;

  function changeChartRange(days) {
    activeChartRange = days;
    
    // Update active tab buttons
    var btns = document.querySelectorAll('.chart-tab-btn');
    btns.forEach(function(btn) {
      var btnDays = 7;
      if (btn.textContent.indexOf('30D') > -1) btnDays = 30;
      else if (btn.textContent.indexOf('90D') > -1) btnDays = 90;
      btn.classList.toggle('active', btnDays === days);
    });
    
    // Update title text
    var titleEl = document.getElementById('chartTitleText');
    if (titleEl) {
      titleEl.textContent = "Skin Score Last " + days + " Days";
    }
    
    // Re-render chart
    var scans = StorageManager.getHistory();
    var chartEl = document.getElementById('progressChart');
    if (chartEl) {
      chartEl.innerHTML = buildLineChart(scans, days).svg;
      var path = chartEl.querySelector('.chart-line');
      if (path && path.getTotalLength) {
        var len = path.getTotalLength();
        path.style.strokeDasharray = len;
        path.style.strokeDashoffset = len;
        requestAnimationFrame(function(){
          requestAnimationFrame(function(){
            path.style.transition = 'stroke-dashoffset 1.1s ease';
            path.style.strokeDashoffset = '0';
          });
        });
      }
    }
  }
  window.changeChartRange = changeChartRange;

  function buildLineChart(scans, days){
    days = days || activeChartRange || 7;
    var cutoff = Date.now() - (days * 24 * 60 * 60 * 1000);
    var displayedScans = scans.filter(function(s) {
      return s.id >= cutoff;
    });

    if (displayedScans.length === 0) {
      return { svg: '<div style="text-align:center; padding:35px 10px; color:var(--text-muted); font-size:12px; font-family:\'Quicksand\',sans-serif;">No scan data available for this range</div>' };
    }
    
    var scores = displayedScans.map(function(s){ return s.score; });
    var w = 300, h = 120, padX = 22, padY = 20;
    var max = 100, min = 40;
    
    var maxScore = Math.max.apply(null, scores);
    var minScore = Math.min.apply(null, scores);
    if (maxScore > 85) max = 100;
    else max = 90;
    if (minScore < 55) min = 30;
    else min = 50;
    
    var stepX = displayedScans.length > 1 ? (w - padX*2) / (displayedScans.length - 1) : 0;
    
    var pts = displayedScans.map(function(s, i){
      var x = displayedScans.length > 1 ? (padX + i*stepX) : w/2;
      var y = padY + (h - padY*2) * (1 - (s.score - min)/(max - min));
      return [x, y];
    });
    
    var pathD = "";
    if (pts.length > 1) {
      pathD = pts.map(function(p, i){ return (i===0?'M':'L') + p[0].toFixed(1) + ',' + p[1].toFixed(1); }).join(' ');
    } else if (pts.length === 1) {
      pathD = 'M' + padX + ',' + pts[0][1].toFixed(1) + ' L' + (w - padX) + ',' + pts[0][1].toFixed(1);
    }
    
    var areaD = "";
    if (pts.length > 1) {
      areaD = pathD + ' L' + pts[pts.length-1][0].toFixed(1) + ',' + (h-padY) + ' L' + pts[0][0].toFixed(1) + ',' + (h-padY) + ' Z';
    } else if (pts.length === 1) {
      areaD = 'M' + padX + ',' + pts[0][1].toFixed(1) + ' L' + (w - padX) + ',' + pts[0][1].toFixed(1) + ' L' + (w - padX) + ',' + (h-padY) + ' L' + padX + ',' + (h-padY) + ' Z';
    }
    
    var dots = pts.map(function(p, i){
      var isLast = i === pts.length - 1;
      return '<circle cx="'+p[0]+'" cy="'+p[1]+'" r="'+(isLast?5:3.5)+'" fill="'+(isLast?'#1F4FD1':'#38bdf8')+'" stroke="#fff" stroke-width="1.5"/>';
    }).join('');
    
    var labels = displayedScans.map(function(s, i){
      var x = pts[i][0];
      var labelText = s.dateStr || "";
      var showLabel = true;
      if (displayedScans.length > 7) {
        if (displayedScans.length <= 14) {
          showLabel = (i % 2 === 0 || i === displayedScans.length - 1);
        } else if (displayedScans.length <= 30) {
          showLabel = (i % 4 === 0 || i === displayedScans.length - 1);
        } else {
          showLabel = (i % 10 === 0 || i === displayedScans.length - 1);
        }
      }
      if (!showLabel) return "";
      return '<text x="'+x+'" y="'+(h-4)+'" font-size="8.5" font-weight="700" fill="#6B7A99" text-anchor="middle" font-family="Nunito">'+labelText+'</text>';
    }).join('');
    
    return {
      svg: '<svg viewBox="0 0 '+w+' '+h+'" width="100%" height="'+h+'" preserveAspectRatio="none" style="display:block;">' +
        '<defs><linearGradient id="areaGrad" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#38bdf8" stop-opacity="0.25"/><stop offset="1" stop-color="#38bdf8" stop-opacity="0"/></linearGradient></defs>' +
        '<path d="'+areaD+'" fill="url(#areaGrad)"/>' +
        '<path d="'+pathD+'" fill="none" stroke="#38bdf8" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="chart-line"/>' +
        dots + labels +
      '</svg>'
    };
  }

  function calculateAverages() {
    var scans = StorageManager.getHistory();
    var avgSkin = 0;
    var avgHydration = 0;
    var checklistCompletion = 0;

    if (scans.length > 0) {
      var sumSkin = 0;
      var sumHydration = 0;
      scans.forEach(function(s) {
        sumSkin += s.score;
        sumHydration += (s.hydration || 75);
      });
      avgSkin = sumSkin / scans.length;
      avgHydration = sumHydration / scans.length;

      var latest = scans[scans.length - 1];
      var rState = StorageManager.getRoutineState();
      var completedCount = 0;
      if (latest && latest.products) {
        latest.products.forEach(function(p) {
          var productKey = latest.score + '_' + p.name.replace(/\s+/g, '_');
          if (rState[productKey]) {
            completedCount++;
          }
        });
        checklistCompletion = latest.products.length > 0 ? (completedCount / latest.products.length) * 100 : 0;
      }
    }

    return {
      skin: avgSkin,
      hydration: avgHydration,
      routine: checklistCompletion
    };
  }

  function renderProgressScreen(){
    var p = LessonEngine.getProgress();
    var xp = p.xp || 0;
    var streak = p.lessonStreak || 0;
    if (typeof MetricsBar !== 'undefined') {
      MetricsBar.update('streak', streak);
      MetricsBar.update('xp', xp);
    } else {
      var sv = document.getElementById('learnStreakVal'); if (sv) sv.textContent = streak;
      var xv = document.getElementById('learnXpVal');     if (xv) xv.textContent = xp;
    }
    if (typeof updateLearnPathNodes === 'function') updateLearnPathNodes();
    return; // new UI is static HTML for now
    var scans = StorageManager.getHistory();
    var avgs = calculateAverages();
    var sortedScans = scans.slice().sort(function(a,b){ return b.id - a.id; });

    // ── Hero ──
    var heroScore = document.getElementById('heroScore');
    var heroDelta = document.getElementById('heroDelta');
    var heroSub   = document.getElementById('heroSub');
    var heroRing  = document.getElementById('heroRingArc');
    var heroRingPct = document.getElementById('heroRingPct');

    if (scans.length === 0) {
      if (heroScore) heroScore.textContent = '—';
      if (heroDelta) heroDelta.textContent = '';
      if (heroSub)   heroSub.textContent   = 'Start scanning to track your progress';
    } else {
      var latest = sortedScans[0].score;
      var prev   = sortedScans.length > 1 ? sortedScans[1].score : latest;
      var delta  = latest - prev;
      if (heroScore) heroScore.textContent = latest;
      if (heroDelta) {
        heroDelta.textContent = (delta >= 0 ? '↑ +' : '↓ ') + delta + ' pts';
        heroDelta.style.background = delta >= 0 ? 'rgba(30,158,107,0.25)' : 'rgba(214,83,109,0.25)';
      }
      if (heroSub) heroSub.textContent = sortedScans[0].headline;
    }

    var circ = 213.6;
    if (heroRing) {
      heroRing.style.transition = 'none';
      heroRing.style.strokeDashoffset = circ;
      var pct = scans.length > 0 ? sortedScans[0].score : 0;
      setTimeout(function() {
        heroRing.style.transition = 'stroke-dashoffset 1.4s cubic-bezier(0.22,1,0.36,1)';
        heroRing.style.strokeDashoffset = circ * (1 - pct / 100);
        if (heroRingPct) heroRingPct.textContent = pct + '%';
      }, 300);
    }

    // ── Metric bars ──
    function animateBar(id, valId, value) {
      var bar = document.getElementById(id);
      var val = document.getElementById(valId);
      if (bar) { bar.style.width = '0%'; setTimeout(function(){ bar.style.width = value + '%'; }, 350); }
      if (val)  val.textContent = value > 0 ? Math.round(value) : '—';
    }
    animateBar('barSkin',      'valSkin',      avgs.skin);
    animateBar('barHydration', 'valHydration', avgs.hydration);
    animateBar('barRoutine',   'valRoutine',   avgs.routine);

    // ── Chart ──
    var btns = document.querySelectorAll('.chart-tab-btn');
    btns.forEach(function(btn) {
      var d = btn.textContent.indexOf('30D') > -1 ? 30 : btn.textContent.indexOf('90D') > -1 ? 90 : 7;
      btn.classList.toggle('active', d === activeChartRange);
    });
    var titleEl = document.getElementById('chartTitleText');
    if (titleEl) titleEl.textContent = 'Last ' + activeChartRange + ' Days';

    var chartEl = document.getElementById('progressChart');
    chartEl.innerHTML = buildLineChart(scans, activeChartRange).svg;
    var path = chartEl.querySelector('.chart-line');
    if (path && path.getTotalLength) {
      var len = path.getTotalLength();
      path.style.strokeDasharray = len;
      path.style.strokeDashoffset = len;
      requestAnimationFrame(function(){ requestAnimationFrame(function(){
        path.style.transition = 'stroke-dashoffset 1.1s ease';
        path.style.strokeDashoffset = '0';
      }); });
    }

    // ── Timeline ──
    var list = document.getElementById('recentScansList');
    if (sortedScans.length === 0) {
      list.innerHTML = '<p style="text-align:center;padding:24px 0;color:var(--text-muted);font-size:13px;font-weight:700;">No scans yet. Tap the camera to start</p>';
      return;
    }

    var html = sortedScans.map(function(s, idx) {
      var c = scoreColor(s.score);
      var d = new Date(s.id);
      var isCollapsed = idx >= 4;
      return '<div class="prog-tl-row' + (isCollapsed ? ' collapsed-scan' : '') + '" data-scan-id="' + s.id + '"' +
        (isCollapsed ? ' style="display:none;"' : '') +
        ' style="animation-delay:' + (idx * 0.07) + 's;">' +
        '<div class="prog-tl-date">' +
          '<span class="prog-tl-day">' + d.getDate() + '</span>' +
          '<span class="prog-tl-mon">' + d.toLocaleDateString(undefined,{month:'short'}) + '</span>' +
        '</div>' +
        '<div class="prog-tl-info">' +
          '<p class="prog-tl-headline">' + s.headline + '</p>' +
          '<p class="prog-tl-rel">' + getRelativeTime(s.id) + '</p>' +
        '</div>' +
        '<span class="prog-tl-score" style="color:' + c + ';">' + s.score + '</span>' +
      '</div>';
    }).join('');

    if (sortedScans.length > 4) {
      html += '<button id="btnRecentScansToggle" style="width:100%;margin-top:4px;padding:11px;background:var(--blue-light);color:var(--blue-primary);border:none;border-radius:14px;font-family:\'Quicksand\',sans-serif;font-size:13px;font-weight:800;cursor:pointer;">View all ' + sortedScans.length + ' scans</button>';
    }

    list.innerHTML = html;

    list.querySelectorAll('.prog-tl-row').forEach(function(row) {
      row.addEventListener('click', function() {
        var scanId = parseInt(row.dataset.scanId, 10);
        var matched = scans.find(function(item){ return item.id === scanId; });
        if (matched) {
          currentProfile = matched;
        }
      });
    });

    var toggleBtn = document.getElementById('btnRecentScansToggle');
    if (toggleBtn) {
      var isExpanded = false;
      toggleBtn.addEventListener('click', function() {
        var collapsedRows = list.querySelectorAll('.collapsed-scan');
        isExpanded = !isExpanded;
        if (isExpanded) {
          collapsedRows.forEach(function(row, cidx) {
            row.style.display = 'flex';
            row.style.animationDelay = (cidx * 0.07) + 's';
          });
          toggleBtn.textContent = 'Show less';
        } else {
          collapsedRows.forEach(function(row) {
            row.style.display = 'none';
          });
          toggleBtn.textContent = 'View More';
        }
      });
    }
  }

  /* ---------- Profile screen ---------- */
  function renderSettings(){ renderProfileScreen(); }

  function renderProfileScreen() {
    // ── Stats ──
    var p = (typeof LessonEngine !== 'undefined') ? LessonEngine.getProgress() : { xp:0, lessonStreak:0, completed:[] };
    var xp       = p.xp || 0;
    var streak   = (typeof StorageManager !== 'undefined') ? StorageManager.getLessonStreak() : (p.lessonStreak || 0);
    var lessons  = (p.completed || []).length;
    var userName = localStorage.getItem('skin_scan_user_name') || 'Guest';

    var el = function(id) { return document.getElementById(id); };
    if (el('profDisplayName')) el('profDisplayName').textContent = userName;
    if (el('profXp'))      el('profXp').textContent      = xp;
    if (el('profStreak'))  el('profStreak').textContent  = streak;
    if (el('profLessons')) el('profLessons').textContent = lessons;

    // ── Badges ──
    var completed = p.completed || [];
    var BADGES = [
      {
        name: 'Welcome Grad', unit: 1, nodes: [1,2],
        color: '#38bdf8', shadow: 'rgba(56,189,248,0.35)',
        icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="#fff"><path d="M12 2l2.2 5.6L20 8.2l-4.3 3.8L17 18l-5-3-5 3 1.3-6L4 8.2l5.8-.6L12 2z"/></svg>'

        icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="#fff"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4" stroke="rgba(16,185,129,0.6)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>'
      },
      {
        name: 'Skin Guru', unit: 5, nodes: [14,15,16],
        color: '#F59E0B', shadow: 'rgba(245,158,11,0.35)',
        icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="#fff"><path d="M3 17h18l-2-10-4 4-3-7-3 7-4-4-2 10zm0 2a1 1 0 0 0 0 2h18a1 1 0 0 0 0-2H3z"/></svg>'
      },
      {
        name: 'Climate Chaser', unit: 6, nodes: [17,18,19],
        color: '#0891b2', shadow: 'rgba(8,145,178,0.35)',
        icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="#fff"><path d="M12 3C8 3 5 6.5 5 10.5A7 7 0 0 0 12 17a7 7 0 0 0 7-6.5C19 6.5 16 3 12 3z"/><path d="M8 19h8M9 22h6" stroke="#fff" stroke-width="2" stroke-linecap="round" fill="none"/></svg>'
      },
      {
        name: 'Label Detective', unit: 7, nodes: [20,21,22],
        color: '#4f46e5', shadow: 'rgba(79,70,229,0.35)',
        icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="#fff"><rect x="4" y="2" width="16" height="20" rx="2"/><rect x="7" y="6" width="10" height="2" rx="1" fill="rgba(79,70,229,0.5)"/><rect x="7" y="10" width="7" height="2" rx="1" fill="rgba(79,70,229,0.5)"/><rect x="7" y="14" width="8" height="2" rx="1" fill="rgba(79,70,229,0.5)"/></svg>'
      },
      {
        name: 'Protein Scholar', unit: 8, nodes: [23,24,25],
        color: '#db2777', shadow: 'rgba(219,39,119,0.35)',
        icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round"><line x1="12" y1="2" x2="12" y2="22"/><path d="M8 5 C10 8 14 8 16 5"/><path d="M8 11 C10 14 14 14 16 11"/><path d="M8 17 C10 20 14 20 16 17"/></svg>'
      },
      {
        name: 'Body Connector', unit: 9, nodes: [26,27],
        color: '#ea580c', shadow: 'rgba(234,88,12,0.35)',
        icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="#fff"><circle cx="12" cy="5" r="3"/><path d="M12 8v5M9 13l-2 4h10l-2-4"/><path d="M7 17l-2 4M17 17l2 4" stroke="#fff" stroke-width="1.5" stroke-linecap="round" fill="none"/></svg>'
      }
    ];

    var LOCK_ICON = '<svg width="22" height="22" viewBox="0 0 24 24" fill="rgba(128,128,128,0.5)"><path d="M17 11V7A5 5 0 0 0 7 7v4H5a1 1 0 0 0-1 1v9a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-9a1 1 0 0 0-1-1h-2zm-5 6a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3zm3-6H9V7a3 3 0 0 1 6 0v4z"/></svg>';

    var grid = el('profBadgesGrid');
    var gridExtra = el('profBadgesGridExtra');
    var overflow = el('profBadgesOverflow');
    var toggleBtn = el('profBadgesToggle');
    var toggleLabel = el('profBadgesToggleLabel');
    if (grid) {
      var badgeHTML = BADGES.map(function(b) {
        var isUnlocked = b.nodes.every(function(n) { return completed.indexOf(n) > -1; });
        var ringStyle  = isUnlocked
          ? 'background:' + b.color + '; border-color:' + b.color + '; box-shadow:0 0 0 4px ' + b.shadow + ';'
          : '';
        var ringClass  = 'prof-badge-ring ' + (isUnlocked ? 'unlocked' : 'locked');
        var icon       = isUnlocked ? b.icon : LOCK_ICON;
        return '<div class="prof-badge-cell' + (isUnlocked ? '' : ' locked') + '">' +
          '<div class="' + ringClass + '" style="' + ringStyle + '">' + icon + '</div>' +
          '<p class="prof-badge-name">' + b.name + '</p>' +
          '</div>';
      });
      // Collapsed teaser: first 2 badges. Expanded: a paginated grid, 8 badges/page.
      var PER_PAGE = 8;
      var totalPages = Math.max(1, Math.ceil(badgeHTML.length / PER_PAGE));
      grid.innerHTML = badgeHTML.slice(0, 2).join('');

      var pageLabel = el('profBadgesPageLabel');
      var prevBtn   = el('profBadgesPrev');
      var nextBtn   = el('profBadgesNext');
      var pager     = el('profBadgesPager');
      if (typeof grid._badgePage !== 'number') grid._badgePage = 0;

      function renderBadgePage() {
        var p = Math.min(grid._badgePage, totalPages - 1);
        grid._badgePage = p;
        if (gridExtra) gridExtra.innerHTML = badgeHTML.slice(p * PER_PAGE, p * PER_PAGE + PER_PAGE).join('');
        if (pageLabel) pageLabel.textContent = 'Page ' + (p + 1) + ' of ' + totalPages;
        if (prevBtn)  prevBtn.disabled = (p === 0);
        if (nextBtn)  nextBtn.disabled = (p >= totalPages - 1);
        if (pager)    pager.style.display = totalPages > 1 ? '' : 'none';
      }
      renderBadgePage();

      if (prevBtn && !prevBtn._bound) {
        prevBtn._bound = true;
        prevBtn.addEventListener('click', function() { if (grid._badgePage > 0) { grid._badgePage--; renderBadgePage(); } });
      }
      if (nextBtn && !nextBtn._bound) {
        nextBtn._bound = true;
        nextBtn.addEventListener('click', function() { if (grid._badgePage < totalPages - 1) { grid._badgePage++; renderBadgePage(); } });
      }

      if (toggleBtn && badgeHTML.length > 2) {
        toggleBtn.style.display = '';
        if (!toggleBtn._bound) {
          toggleBtn._bound = true;
          toggleBtn.addEventListener('click', function() {
            var isOpen = overflow.classList.toggle('open');
            toggleBtn.classList.toggle('open', isOpen);
            toggleLabel.textContent = isOpen ? 'Show less' : 'Show all badges';
            // Hide the 2-badge teaser while the full paginated list is open
            grid.classList.toggle('prof-badges-teaser-hidden', isOpen);
            if (isOpen) { grid._badgePage = 0; renderBadgePage(); }
          });
        }
      }
    }

    // ── Preferences wiring (idempotent via _prefBound guard) ──
    var reminderToggle = el('prefReminderToggle');
    if (reminderToggle) {
      reminderToggle.checked = localStorage.getItem('notif_daily') !== 'false';
      if (!reminderToggle._prefBound) {
        reminderToggle._prefBound = true;
        reminderToggle.addEventListener('change', function() {
          if (window.webkit && window.webkit.messageHandlers && window.webkit.messageHandlers.hapticSelection) {
            window.webkit.messageHandlers.hapticSelection.postMessage(null);
          }
          localStorage.setItem('notif_daily', this.checked ? 'true' : 'false');
        });
      }
    }

    var themeSeg = el('themeSeg');
    if (themeSeg && !themeSeg._prefBound) {
      themeSeg._prefBound = true;
      var currentPref = localStorage.getItem('glowo_theme') || 'system';
      themeSeg.querySelectorAll('.theme-seg-btn').forEach(function(btn) {
        if (btn.dataset.val === currentPref) btn.classList.add('active');
        btn.addEventListener('click', function() {
          if (window.webkit && window.webkit.messageHandlers && window.webkit.messageHandlers.hapticSelection) {
            window.webkit.messageHandlers.hapticSelection.postMessage(null);
          }
          var val = btn.dataset.val;
          localStorage.setItem('glowo_theme', val);
          themeSeg.querySelectorAll('.theme-seg-btn').forEach(function(b) { b.classList.remove('active'); });
          btn.classList.add('active');
          if (window._applyTheme) window._applyTheme(val);
        });
      });
    }

    var privacyRow = el('prefPrivacy');
    if (privacyRow && !privacyRow._prefBound) {
      privacyRow._prefBound = true;
      privacyRow.addEventListener('click', function() {
        if (window.webkit && window.webkit.messageHandlers && window.webkit.messageHandlers.hapticSelection) {
          window.webkit.messageHandlers.hapticSelection.postMessage(null);
        }
        document.getElementById('screen-privacy').classList.add('open');
      });
    }

    var termsRow = el('prefTerms');
    if (termsRow && !termsRow._prefBound) {
      termsRow._prefBound = true;
      termsRow.addEventListener('click', function() {
        if (window.webkit && window.webkit.messageHandlers && window.webkit.messageHandlers.hapticSelection) {
          window.webkit.messageHandlers.hapticSelection.postMessage(null);
        }
        document.getElementById('screen-terms').classList.add('open');
      });
    }

    var clearRow = el('prefClearData');
    if (clearRow && !clearRow._prefBound) {
      clearRow._prefBound = true;
      clearRow.addEventListener('click', function() {
        if (window.webkit && window.webkit.messageHandlers && window.webkit.messageHandlers.hapticSelection) {
          window.webkit.messageHandlers.hapticSelection.postMessage(null);
        }
        if (confirm('Reset all progress, routine data, and account info?')) {
          localStorage.clear();
          location.reload();
        }
      });
    }
  }

  function openNotificationsSheet() {
    var isDaily = localStorage.getItem('notif_daily') !== 'false';
    var isRoutine = localStorage.getItem('notif_routine') !== 'false';
    var isInsights = localStorage.getItem('notif_insights') === 'true';

    var html = '<div style="padding-top:10px;">' +
      '<h3 style="font-family:\'Quicksand\',sans-serif; margin-bottom:16px;">Notifications Settings</h3>' +
      '<div style="display:flex; flex-direction:column; gap:16px;">' +
        '<div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid #F1F4FA; padding-bottom:12px;">' +
          '<div>' +
            '<p style="font-weight:700; font-size:15px; margin:0;">Daily Scan Reminder</p>' +
            '<p style="font-size:12.5px; color:var(--text-muted); margin:4px 0 0 0;">Receive a notification to scan your skin every morning.</p>' +
          '</div>' +
          '<label class="ios-switch"><input type="checkbox" ' + (isDaily ? 'checked' : '') + ' id="notifDaily"><span class="slider"></span></label>' +
        '</div>' +
        '<div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid #F1F4FA; padding-bottom:12px;">' +
          '<div>' +
            '<p style="font-weight:700; font-size:15px; margin:0;">Routine Reminders</p>' +
            '<p style="font-size:12.5px; color:var(--text-muted); margin:4px 0 0 0;">Get notified to complete your morning/evening routines.</p>' +
          '</div>' +
          '<label class="ios-switch"><input type="checkbox" ' + (isRoutine ? 'checked' : '') + ' id="notifRoutine"><span class="slider"></span></label>' +
        '</div>' +
        '<div style="display:flex; justify-content:space-between; align-items:center; padding-bottom:12px;">' +
          '<div>' +
            '<p style="font-weight:700; font-size:15px; margin:0;">Product Insights</p>' +
            '<p style="font-size:12.5px; color:var(--text-muted); margin:4px 0 0 0;">Receive skin care tips based on your scan trends.</p>' +
          '</div>' +
          '<label class="ios-switch"><input type="checkbox" ' + (isInsights ? 'checked' : '') + ' id="notifInsights"><span class="slider"></span></label>' +
        '</div>' +
      '</div>' +
      '<button class="btn-primary full" style="margin-top:20px;" id="btnSaveNotifs">Save Settings</button>' +
    '</div>';

    BottomSheetManager.open(html);

    document.getElementById('btnSaveNotifs').addEventListener('click', function() {
      localStorage.setItem('notif_daily', document.getElementById('notifDaily').checked);
      localStorage.setItem('notif_routine', document.getElementById('notifRoutine').checked);
      localStorage.setItem('notif_insights', document.getElementById('notifInsights').checked);
      BottomSheetManager.close();
    });
  }

  function openPrivacySheet() {
    var html = '<div style="padding-top:10px;">' +
      '<h3 style="font-family:\'Quicksand\',sans-serif; margin-bottom:12px;">Privacy Policy</h3>' +
      '<p style="font-size:14px; line-height:1.5; color:var(--text-dark); margin-bottom:12px;">' +
        'At Glowo, your privacy is our top priority. All photos and scan measurements are processed entirely on your device using client-side WebGL/Canvas APIs.' +
      '</p>' +
      '<p style="font-size:14px; line-height:1.5; color:var(--text-dark); margin-bottom:12px;">' +
        '<strong>No Personal Data is Uploaded:</strong>' +
      '</p>' +
      '<ul style="list-style:disc; padding-left:20px; font-size:13.5px; line-height:1.5; color:var(--text-muted); margin-bottom:16px; display:flex; flex-direction:column; gap:6px;">' +
        '<li>Camera streams are never recorded or stored.</li>' +
        '<li>Scan calculations are done dynamically in your browser.</li>' +
        '<li>History and preferences are saved locally on this device via LocalStorage.</li>' +
      '</ul>' +
      '<button class="btn-primary full" id="btnClosePrivacy">I Understand</button>' +
    '</div>';
    BottomSheetManager.open(html);
    document.getElementById('btnClosePrivacy').addEventListener('click', function() {
      BottomSheetManager.close();

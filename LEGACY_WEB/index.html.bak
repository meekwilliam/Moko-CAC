        {icon:"⚪️", bg:"#EDF0F6", label:"Pores & Acne", status:"Balanced", cls:"neutral"},
        {icon:"🔴", bg:"#FCE3E8", label:"Redness & Calm", status:"Elevated", cls:"warn"},
        {icon:"🛢️", bg:"#DCEBFF", label:"Oiliness", status:"Low", cls:"neutral"}
      ],
      products: [

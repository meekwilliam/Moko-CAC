              <path d="M6 4 L10 52 L30 52 L34 4 Z" fill="rgba(26,125,232,0.10)" stroke="#1A7DE8" stroke-width="2" stroke-linejoin="round"/>
              <!-- fill level (clipped by glass shape, JS updates height via clip) -->
              <clipPath id="glassClip"><path d="M6 4 L10 52 L30 52 L34 4 Z"/></clipPath>
              <rect id="waterFillRect" x="6" y="52" width="28" height="0" fill="rgba(26,125,232,0.55)" clip-path="url(#glassClip)"/>
              <!-- rim highlight -->
              <line x1="6" y1="4" x2="34" y2="4" stroke="#1A7DE8" stroke-width="2" stroke-linecap="round"/>
            </svg>
            <div class="water-text-group">

            <p class="prof-sub" id="profSubLine">Skincare Learner</p>
          </div>
        </div>
        <div class="prof-bento">
          <!-- Day Streak — double-wide hero -->
          <div class="prof-bento-streak">
            <div class="prof-bento-icon">
              <svg width="30" height="30" viewBox="0 0 24 24" fill="#fff"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>
            </div>
            <div class="prof-bento-streak-text">
              <p class="prof-bento-val" id="profStreak">0</p>
              <p class="prof-bento-label">Day Streak</p>
            </div>
          </div>
          <!-- XP + Lessons — matched smaller cards -->
          <div class="prof-bento-row">
            <div class="prof-bento-cell prof-bento-xp">
              <p class="prof-bento-val" id="profXp">0</p>
              <p class="prof-bento-label">Total XP</p>
            </div>
            <div class="prof-bento-cell prof-bento-lessons">
              <p class="prof-bento-val" id="profLessons">0</p>
              <p class="prof-bento-label">Lessons</p>
            </div>
          </div>
        </div>
      </div>

      <!-- ── 2. Trophy Room ── -->
      <div class="prof-card fade-item" style="animation-delay:.10s">
        <div class="prof-section-title-row">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="#F5A623"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <p class="prof-section-title">Earned Badges</p>
        </div>
        <div class="prof-badges-grid" id="profBadgesGrid">
          <!-- first 2 badges injected here -->
        </div>
        <div class="prof-badges-overflow" id="profBadgesOverflow">
          <div class="prof-badges-grid" id="profBadgesGridExtra">
            <!-- current page of badges (8 per page) injected here -->
          </div>
          <div class="prof-badges-pager" id="profBadgesPager" style="display:none">
            <button class="prof-badges-pager-btn" id="profBadgesPrev" aria-label="Previous page">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <span class="prof-badges-pager-label" id="profBadgesPageLabel">Page 1 of 1</span>
            <button class="prof-badges-pager-btn" id="profBadgesNext" aria-label="Next page">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
          </div>
        </div>
        <button class="prof-badges-toggle" id="profBadgesToggle" style="display:none">
          <span id="profBadgesToggleLabel">Show all badges</span>
          <span class="prof-badges-toggle-chevron">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </span>
        </button>
      </div>

      <!-- ── 3. Preferences ── -->
      <div class="prof-card fade-item" style="animation-delay:.16s">
        <div class="prof-section-title-row">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="var(--text-muted)"><path fill-rule="evenodd" d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z M15 12a3 3 0 1 0-6 0 3 3 0 0 0 6 0z"/></svg>
          <p class="prof-section-title">Preferences</p>
        </div>

        <div class="prof-pref-list">

        <!-- Daily Reminders -->
        <div class="prof-pref-row" id="prefReminders">
          <div class="prof-pref-icon" style="background:rgba(245,166,35,0.12);">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="#F5A623"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9z"/><path d="M10.27 19a2 2 0 0 0 3.46 0H10.27z"/></svg>
          </div>
          <span class="prof-pref-label">Daily Reminders</span>
          <label class="prof-toggle">
            <input type="checkbox" id="prefReminderToggle">
            <div class="prof-toggle-track"></div>
            <div class="prof-toggle-thumb"></div>
          </label>
        </div>

        <!-- Theme -->
        <div class="prof-pref-row" id="prefThemeRow" style="flex-direction:column; align-items:flex-start; gap:10px;">
          <div style="display:flex; align-items:center; gap:12px; width:100%;">
            <div class="prof-pref-icon" style="background:rgba(148,163,184,0.12);">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="#94a3b8"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
            </div>
            <span class="prof-pref-label">Theme</span>
          </div>
          <div class="theme-seg" id="themeSeg">
            <button class="theme-seg-btn" data-val="system">System</button>
            <button class="theme-seg-btn" data-val="light">Light</button>
            <button class="theme-seg-btn" data-val="dark">Dark</button>
          </div>
        </div>

        <!-- Privacy Policy -->
        <div class="prof-pref-row" id="prefPrivacy">
          <div class="prof-pref-icon" style="background:rgba(56,189,248,0.12);">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <span class="prof-pref-label">Privacy Policy</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </div>

        <!-- Terms -->
        <div class="prof-pref-row" id="prefTerms">
          <div class="prof-pref-icon" style="background:rgba(99,102,241,0.12);">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6366F1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
          </div>
          <span class="prof-pref-label">Terms &amp; Legal Disclaimer</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </div>

        <!-- Clear Data -->
        <div class="prof-pref-row" id="prefClearData">
          <div class="prof-pref-icon" style="background:rgba(214,83,109,0.12);">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="#D6536D"><path d="M9 3a1 1 0 0 0-1 1H5a1 1 0 1 0 0 2h14a1 1 0 1 0 0-2h-3a1 1 0 0 0-1-1H9zm-3 5 1.5 13A1 1 0 0 0 8.5 22h7a1 1 0 0 0 1-.97L18 8H6z"/></svg>
          </div>
          <span class="prof-pref-label prof-danger-label">Clear Application Data</span>
          <span class="prof-pref-chevron">›</span>
        </div>

        </div><!-- /prof-pref-list -->

      </div>
    </div>
    </div>
  </section>

  <!-- ONBOARDING — name only -->
  <section class="screen" id="screen-signup" style="overflow:hidden;">
    <style>
      #screen-signup {
        background: linear-gradient(160deg, #0ea5e9 0%, #38bdf8 50%, #7dd3fc 100%);
      }
      body.dark-mode #screen-signup {
        background: #0B0F19;
      }
      /* Heart badge */
      #signup-heart-badge {
        width: 72px; height: 72px; border-radius: 22px;
        background: #38bdf8;
        border: 2px solid #0ea5e9;
        box-shadow: 0 5px 0 0 #0284c7, inset 0 1px 0 rgba(255,255,255,0.30);
        display: flex; align-items: center; justify-content: center;
        transition: box-shadow 0.08s ease, transform 0.08s ease;
      }
      body.dark-mode #signup-heart-badge {
        background: #1e3a5f;
        border: 2px solid #334155;
        box-shadow: 0 5px 0 0 #0f2440, inset 0 1px 0 rgba(255,255,255,0.08);
      }
      /* Heading */
      #signup-heading {
        font-family: 'Nunito', sans-serif; font-size: 30px; font-weight: 900;
        color: #fff; margin: 0 0 10px 0; letter-spacing: -0.5px;
        text-shadow: 0 2px 8px rgba(0,0,0,0.12);
      }
      body.dark-mode #signup-heading { color: #F8FAFC; text-shadow: none; }
      #signup-sub {
        font-size: 15px; color: rgba(255,255,255,0.88); margin: 0; line-height: 1.55;
        font-family: 'Nunito', sans-serif;
      }
      body.dark-mode #signup-sub { color: rgba(148,163,184,1); }
      /* Main card */
      #signup-card {
        width: 100%; background: #fff;
        border-radius: 24px;
        border: 2px solid #CBD5E1;
        box-shadow: 0 5px 0 0 #B0BFCF, inset 0 1px 0 rgba(255,255,255,0.9);
        padding: 20px 20px 20px;
        display: flex; flex-direction: column; gap: 14px;
        position: relative;
        margin-top: 28px;
      }
      body.dark-mode #signup-card {
        background: #1E293B;
        border: 2px solid #334155;
        box-shadow: 0 5px 0 0 #0F172A, inset 0 1px 0 rgba(255,255,255,0.05);
      }
      /* Mascot peek */
      #signup-mascot-peek {
        position: absolute; top: -72px; right: 18px;
        width: 86px; height: 86px;
        pointer-events: none; z-index: 2;
        animation: fadeUp 0.5s cubic-bezier(.22,1,.36,1) both;
        animation-delay: 0.15s;
      }
      /* Input */
      #signupName {
        width: 100%; box-sizing: border-box;
        padding: 14px 16px;
        border: 2px solid #94A3B8;
        border-radius: 14px;
        font-size: 16px; font-family: 'Nunito', sans-serif; font-weight: 700;
        color: #0F172A; background: #F8FAFC;
        outline: none;
        transition: border-color 0.15s, box-shadow 0.15s;
        box-shadow: 0 3px 0 0 #78909C, inset 0 1px 0 rgba(255,255,255,0.9);
      }
      #signupName::placeholder { color: #94A3B8; font-weight: 700; }
      #signupName:focus {
        border-color: #38bdf8;
        box-shadow: 0 3px 0 0 #0284c7, 0 0 0 3px rgba(56,189,248,0.18), inset 0 1px 0 rgba(255,255,255,0.9);
      }
      body.dark-mode #signupName {
        background: #0F172A; color: #F8FAFC;
        border: 2px solid #334155;
        box-shadow: 0 3px 0 0 rgba(0,0,0,0.50), inset 0 1px 0 rgba(255,255,255,0.04);
      }
      body.dark-mode #signupName::placeholder { color: #475569; }
      body.dark-mode #signupName:focus {
        border-color: #38bdf8;
        box-shadow: 0 3px 0 0 #0284c7, 0 0 0 3px rgba(56,189,248,0.22), inset 0 1px 0 rgba(255,255,255,0.04);
      }
      /* CTA button */
      #btnCreateAccount {
        width: 100%; margin: 0;
        padding: 16px;
        background: #38bdf8; color: #fff;
        border: none; border-radius: 16px;
        font-family: 'Nunito', sans-serif; font-size: 16px; font-weight: 900;
        cursor: pointer; letter-spacing: 0.2px;
        box-shadow: 0 5px 0 0 #0284c7, inset 0 1px 0 rgba(255,255,255,0.25);
        transition: transform 0.08s ease, box-shadow 0.08s ease;
        touch-action: manipulation; -webkit-user-select: none;
      }
      #btnCreateAccount:active {
        transform: translateY(5px);
        box-shadow: 0 0px 0 0 #0284c7, inset 0 1px 0 rgba(255,255,255,0.15);
      }
      body.dark-mode #btnCreateAccount {
        background: #0ea5e9;
        box-shadow: 0 5px 0 0 #0369a1, inset 0 1px 0 rgba(255,255,255,0.20);
      }
      body.dark-mode #btnCreateAccount:active {
        box-shadow: 0 0px 0 0 #0369a1;
      }
      /* Skip */
      #btnSkipSignup {
        background: none; border: none; font-size: 14px;
        color: rgba(255,255,255,0.80);
        font-family: 'Nunito', sans-serif; font-weight: 700;
        cursor: pointer; padding: 8px;
        transition: color 0.15s;
      }
      body.dark-mode #btnSkipSignup { color: #475569; }
    </style>

    <div style="width:100%; max-width:400px; margin:0 auto; padding: max(64px, env(safe-area-inset-top)) 28px max(40px, env(safe-area-inset-bottom)) 28px; box-sizing:border-box; display:flex; flex-direction:column; align-items:center; justify-content:center; min-height:100%; gap:0;">

      <!-- Heart badge -->
      <div class="fade-item" style="margin-bottom:24px;">
        <div id="signup-heart-badge">
          <svg width="34" height="34" viewBox="0 0 24 24" fill="#fff">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
          </svg>
        </div>
      </div>

      <!-- Heading -->
      <div class="fade-item" style="text-align:center; margin-bottom:8px;">
        <h1 id="signup-heading">What should we call you?</h1>
        <p id="signup-sub">We'll use this to personalise your Glowo experience.</p>
      </div>

      <!-- Input card with mascot peeking -->
      <div class="fade-item" id="signup-card">
        <!-- Mascot peeking over top edge -->
        <div id="signup-mascot-peek" aria-hidden="true"></div>

        <input type="text" id="signupName" placeholder="Enter your name" autocomplete="given-name">
        <button id="btnCreateAccount">Let's go →</button>
      </div>

      <!-- Skip -->
      <div class="fade-item" style="text-align:center; margin-top:14px;">
        <button id="btnSkipSignup">Skip for now</button>
      </div>

    </div>
  </section>

</div>

  <!-- iOS STACKED BOTTOM SHEET -->
  <div class="sheet-backdrop" id="sheetBackdrop"></div>
  <div class="ios-sheet" id="iosSheet">
    <div class="sheet-handle-bar" id="sheetHandleBar">
      <div class="sheet-handle"></div>
    </div>
    <div class="sheet-content" id="sheetContent">
      <!-- Dynamic bottom sheet content injected here -->
    </div>
  </div>

  <!-- BOTTOM NAV -->
  <nav class="bottom-nav" id="bottomNav">
    <button class="nav-item" data-screen="screen-dashboard">
      <svg viewBox="0 0 24 24" width="24" height="24">
        <!-- House Filled -->
        <path d="M12,3 L3,11.5 V21 H9 V15 H15 V21 H21 V11.5 Z" class="icon-fill"/>
        <!-- Blobin peeking from window -->
        <path d="M9.5,14 C9.5,10.5 14.5,10.5 14.5,14 Z" class="mascot-part" />
        <!-- Glasses -->
        <circle cx="11" cy="11.5" r="1.3" fill="none" class="mascot-glasses" stroke-width="0.6"/>
        <circle cx="13" cy="11.5" r="1.3" fill="none" class="mascot-glasses" stroke-width="0.6"/>
        <!-- Bridge -->
        <line x1="12" y1="11.5" x2="12" y2="11.5" class="mascot-glasses" stroke-width="0.6"/>
        <!-- Eyes -->
        <circle cx="11" cy="11.5" r="0.4" fill="#000442"/>
        <circle cx="13" cy="11.5" r="0.4" fill="#000442"/>
        <!-- Smile -->
        <path d="M11.5,13 Q12,13.8 12.5,13" stroke="#000442" stroke-width="0.5" fill="none"/>
      </svg>
    </button>
    <button class="nav-item active" data-screen="screen-progress">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="none">
        <!-- Map Filled -->
        <polygon points="1,6 1,22 8,18 16,22 23,18 23,2 16,6 8,2" class="icon-fill"/>
        <!-- Fold lines in contrasting color to show map panels -->
        <line x1="8" y1="2" x2="8" y2="18" stroke="var(--bg-frame)" stroke-width="1.5" stroke-linecap="round"/>
        <line x1="16" y1="6" x2="16" y2="22" stroke="var(--bg-frame)" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>
    <button class="nav-item" data-screen="screen-profile">
      <svg viewBox="0 0 24 24" width="24" height="24">
        <!-- User Outline -->
        <path d="M4,20 C4,16 8,14.5 12,14.5 C16,14.5 20,16 20,20" fill="none" class="icon-stroke" stroke-width="2" stroke-linecap="round"/>
        <!-- Blobin Head (Circular to avoid being smooshed) -->
        <circle cx="12" cy="8" r="3.8" class="mascot-part" />
        <!-- Glasses -->
        <circle cx="10.8" cy="8" r="1.2" fill="none" class="mascot-glasses" stroke-width="0.6"/>
        <circle cx="13.2" cy="8" r="1.2" fill="none" class="mascot-glasses" stroke-width="0.6"/>
        <line x1="11.8" y1="8" x2="12.2" y2="8" class="mascot-glasses" stroke-width="0.6"/>
        <!-- Eyes -->
        <circle cx="10.8" cy="8" r="0.4" fill="#000442"/>
        <circle cx="13.2" cy="8" r="0.4" fill="#000442"/>
        <!-- Smile -->
        <path d="M11.3,9.5 Q12,10.1 12.7,9.5" stroke="#000442" stroke-width="0.5" fill="none"/>
      </svg>
    </button>
  </nav>

  <!-- DYNAMIC DAILY LIMIT POPUP MODAL -->
  <div class="paywall-modal" id="paywallModal">
    <div class="paywall-content" style="position: relative;">
      <!-- Close button (✕) in the top-right -->
      <button class="paywall-close-x" id="btnPaywallCloseX" aria-label="Close"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
      
      <div class="paywall-crown-icon" style="display:flex; justify-content:center; align-items:center; margin-bottom:12px;">
        <!-- Beautiful clock/calendar SVG icon -->
        <svg width="48" height="48" viewBox="0 0 24 24" fill="var(--blue-primary)">
          <path d="M12 2a10 10 0 1 1 0 20A10 10 0 0 1 12 2zm0 4a1 1 0 0 0-1 1v5a1 1 0 0 0 .45.83l3.5 2.25a1 1 0 1 0 1.1-1.66L13 11.42V7a1 1 0 0 0-1-1z"/>
        </svg>
      </div>
      <h2 class="paywall-title">Daily Limit Reached</h2>
      <p class="paywall-subtitle">Scans are strictly limited to one per day. Maintain your streak and check back tomorrow for your next skin analysis!</p>
      
      <div class="paywall-features" style="width: 100%; margin-top: 8px;">
        <div style="background: var(--bg-card); border: 1px solid rgba(62, 123, 250, 0.12); border-radius: 16px; padding: 16px; margin-bottom: 20px;">
          <div style="font-size: 11px; color: var(--text-muted); text-transform: uppercase; font-weight: 800; letter-spacing: 0.5px; margin-bottom: 4px;">Next Scan Available In</div>
          <div id="dailyLimitTimer" style="font-size: 24px; font-weight: 800; color: var(--blue-primary); font-family: monospace; letter-spacing: 0.5px;">--h --m --s</div>
        </div>
      </div>
      
      <div class="paywall-actions" style="width: 100%;">
        <button class="btn-primary full" id="btnGotItDailyLimit">Got It</button>
      </div>
    </div>
  </div>

  <!-- UPGRADE REAL ANALYSIS LOADING OVERLAY -->
  <div class="paywall-loading-overlay" id="paywallLoadingOverlay">
    <svg class="ios-spinner" style="width:48px; height:48px; animation:iosSpin 1s linear infinite;" viewBox="0 0 24 24" fill="none">
      <circle cx="12" cy="12" r="10" stroke="rgba(56,189,248,0.15)" stroke-width="3"/>
      <path d="M12 2 A 10 10 0 0 1 22 12" stroke="var(--blue-primary)" stroke-width="3"/>
    </svg>
    <div>
      <h3 class="paywall-loading-title" id="paywallLoadingTitle">Consulting Glowy AI...</h3>
      <p class="paywall-loading-desc" id="paywallLoadingDesc">Upgrading your profile to Glowo Premium and executing dermatologist-grade face scan analysis.</p>
    </div>
  </div>

</div>

<script>
  // ── SFX Module — must be defined before any render functions that call it ──
  var SFX = (function() {
    var ctx = null;
    function getCtx() {
      if (!ctx) ctx = new (window.AudioContext || window.webkitAudioContext)();
      return ctx;
    }
    function osc(type, freq0, freq1, dur, vol, freqTime) {
      try {
        var c = getCtx();
        var o = c.createOscillator();
        var g = c.createGain();
        o.connect(g); g.connect(c.destination);
        o.type = type;
        o.frequency.setValueAtTime(freq0, c.currentTime);
        o.frequency.exponentialRampToValueAtTime(freq1, c.currentTime + (freqTime || dur));
        g.gain.setValueAtTime(vol, c.currentTime);
        g.gain.exponentialRampToValueAtTime(0.0001, c.currentTime + dur);
        o.start(c.currentTime);
        o.stop(c.currentTime + dur);
      } catch(e) {}
    }
    function twoTone(f1, f2, dur, vol) {
      try {
        var c = getCtx();
        [f1, f2].forEach(function(f, i) {
          var o = c.createOscillator(), g = c.createGain();
          o.connect(g); g.connect(c.destination);
          o.type = 'sine'; o.frequency.value = f;
          var t = c.currentTime + i * (dur * 0.55);
          g.gain.setValueAtTime(vol, t);
          g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
          o.start(t); o.stop(t + dur);
        });
      } catch(e) {}
    }
    return {
      nodeTap:  function() { osc('sine',     900, 400, 0.10, 0.18); },
      select:   function() { osc('sine',     660, 580, 0.07, 0.12); },
      correct:  function() { twoTone(660, 880, 0.12, 0.20); },
      wrong:    function() { osc('triangle', 200, 120, 0.16, 0.22); },
      check:    function() { osc('sine', 520, 260, 0.09, 0.14); },
      water:    function() { osc('sine',     400, 700, 0.12, 0.16, 0.10); },
      advance:  function() { osc('sine',     520, 480, 0.08, 0.13); },
      reward: function() {
        try {
          var c = getCtx();
          [523, 659, 784, 1047].forEach(function(f, i) {
            var o = c.createOscillator(), g = c.createGain();
            o.connect(g); g.connect(c.destination);
            o.type = 'sine'; o.frequency.value = f;
            var t = c.currentTime + i * 0.10;
            g.gain.setValueAtTime(0.18, t);
            g.gain.exponentialRampToValueAtTime(0.0001, t + 0.18);
            o.start(t); o.stop(t + 0.20);
          });
        } catch(e) {}
      },
      // Unit complete — longer arpeggio climbing to a higher note
      unitReward: function() {
        try {
          var c = getCtx();
          [392, 523, 659, 784, 988, 1175, 1568].forEach(function(f, i) {
            var o = c.createOscillator(), g = c.createGain();
            o.connect(g); g.connect(c.destination);
            o.type = 'sine'; o.frequency.value = f;
            var t = c.currentTime + i * 0.09;
            var vol = i < 5 ? 0.16 : 0.22;
            g.gain.setValueAtTime(vol, t);
            g.gain.exponentialRampToValueAtTime(0.0001, t + 0.22);
            o.start(t); o.stop(t + 0.24);
          });
        } catch(e) {}
      },
    };
  })();

try {
  function getRelativeTime(timestamp) {
    if (!timestamp) return "Just now";
    var now = Date.now();
    var diff = now - timestamp;
    if (diff < 60000) {
      return "Just now";
    }
    
    var diffMinutes = Math.floor(diff / 60000);
    if (diffMinutes < 60) {
      return diffMinutes + "m ago";
    }
    
    var d = new Date(timestamp);
    var today = new Date();
    
    var isSameDay = d.getDate() === today.getDate() && 
                    d.getMonth() === today.getMonth() && 
                    d.getFullYear() === today.getFullYear();
                    
    if (isSameDay) {
      return d.toLocaleTimeString(undefined, { hour: 'numeric', minute: '2-digit' });
    }
    
    var yesterday = new Date(today);
    yesterday.setDate(today.getDate() - 1);
    var isYesterday = d.getDate() === yesterday.getDate() && 
                      d.getMonth() === yesterday.getMonth() && 
                      d.getFullYear() === yesterday.getFullYear();
                      
    if (isYesterday) {
      return "Yesterday";
    }
    
    return d.toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
  }

  var BottomSheetManager = {
    backdropEl: null,
    sheetEl: null,
    contentEl: null,
    screenStackEl: null,
    handleBarEl: null,
    isOpen: false,
    
    startY: 0,
    currentY: 0,
    isDragging: false,
    dragThreshold: 85,

    init: function() {
      this.backdropEl = document.getElementById('sheetBackdrop');
      this.sheetEl = document.getElementById('iosSheet');
      this.contentEl = document.getElementById('sheetContent');
      this.screenStackEl = document.getElementById('screenStack');
      this.handleBarEl = document.getElementById('sheetHandleBar');
      
      var self = this;
      
      this.backdropEl.addEventListener('click', function() {
        self.close();
      });
      
      this.handleBarEl.addEventListener('touchstart', function(e) { self.onTouchStart(e); }, {passive: true});
      this.handleBarEl.addEventListener('touchmove', function(e) { self.onTouchMove(e); }, {passive: false});
      this.handleBarEl.addEventListener('touchend', function(e) { self.onTouchEnd(e); }, {passive: true});
      
      this.contentEl.addEventListener('touchstart', function(e) {
        self.startY = e.touches[0].clientY;
        self.currentY = self.startY;
        if (self.contentEl.scrollTop <= 0) {
          self.onTouchStart(e);
        }
      }, {passive: true});
      
      this.contentEl.addEventListener('touchmove', function(e) {
        var currentY = e.touches[0].clientY;
        if (self.isDragging) {
          self.onTouchMove(e);
        } else if (self.contentEl.scrollTop <= 0 && currentY > self.startY) {
          self.onTouchStart(e);
          self.startY = currentY; // Adjust start point to prevent jump
          self.onTouchMove(e);
        }
      }, {passive: false});
      
      this.contentEl.addEventListener('touchend', function(e) {
        if (self.isDragging) {
          self.onTouchEnd(e);
        }
      }, {passive: true});
    },

    onTouchStart: function(e) {
      if (!this.isOpen) return;
      this.startY = e.touches[0].clientY;
      this.currentY = this.startY;
      this.isDragging = true;
      this.sheetEl.style.transition = 'none';
    },

    onTouchMove: function(e) {
      if (!this.isDragging) return;
      this.currentY = e.touches[0].clientY;
      var deltaY = this.currentY - this.startY;
      if (deltaY > 0) {
        e.preventDefault();
        this.sheetEl.style.transform = 'translateY(' + deltaY + 'px)';
        var opacity = Math.max(0, 1 - (deltaY / 300)) * 0.35;
        this.backdropEl.style.backgroundColor = 'rgba(0, 0, 0, ' + opacity + ')';
      }
    },

    onTouchEnd: function(e) {
      if (!this.isDragging) return;
      this.isDragging = false;
      this.sheetEl.style.transition = '';
      this.backdropEl.style.backgroundColor = '';
      
      var deltaY = this.currentY - this.startY;
      if (deltaY > this.dragThreshold) {
        this.close();
      } else {
        this.sheetEl.style.transform = '';
      }
    },

    open: function(htmlContent) {
      if (!this.sheetEl) this.init();
      
      this.contentEl.innerHTML = htmlContent;
      this.isOpen = true;
      
      // Clear inline styles before opening
      this.sheetEl.style.transition = '';
      this.sheetEl.style.transform = '';
      this.backdropEl.style.backgroundColor = '';
      
      this.backdropEl.classList.add('active');
      this.sheetEl.classList.add('active');
      this.screenStackEl.classList.add('scaled-back');
    },

    close: function() {
      if (!this.isOpen) return;
      this.isOpen = false;
      this.isDragging = false;
      
      // Clean up drag-to-dismiss inline style overrides
      this.sheetEl.style.transition = '';
      this.sheetEl.style.transform = '';
      this.backdropEl.style.backgroundColor = '';
      
      this.backdropEl.classList.remove('active');
      this.sheetEl.classList.remove('active');
      this.screenStackEl.classList.remove('scaled-back');
      
      var self = this;
      setTimeout(function() {
        if (!self.isOpen) {
          self.contentEl.innerHTML = '';
        }
      }, 400);
    }
  };

  var PullToRefresh = {
    screenEl: null,
    spinnerEl: null,
    ptrEl: null,
    
    startY: 0,
    currentY: 0,
    isPulling: false,
    isRefreshing: false,
    pullMax: 80,
    pullThreshold: 60,

    init: function() {
      this.screenEl = document.getElementById('screen-dashboard');
      this.ptrEl = document.getElementById('pullRefresh');
      this.spinnerEl = document.getElementById('refreshSpinner');
      
      var self = this;
      
      this.screenEl.addEventListener('touchstart', function(e) { self.onTouchStart(e); }, {passive: true});
      this.screenEl.addEventListener('touchmove', function(e) { self.onTouchMove(e); }, {passive: false});
      this.screenEl.addEventListener('touchend', function(e) { self.onTouchEnd(e); }, {passive: true});
    },

    onTouchStart: function(e) {
      if (this.isRefreshing) return;
      if (this.screenEl.scrollTop <= 0) {
        this.startY = e.touches[0].clientY;
        this.currentY = this.startY;
        this.isPulling = true;
        
        var contentPad = document.getElementById('dashboardContentPad');
        contentPad.style.transition = 'none';
        this.ptrEl.style.transition = 'none';
      }
    },

    onTouchMove: function(e) {
      if (!this.isPulling) return;
      this.currentY = e.touches[0].clientY;
      var deltaY = this.currentY - this.startY;
      
      if (deltaY > 0) {
        var pullOffset = Math.min(this.pullMax, Math.pow(deltaY, 0.85));
        e.preventDefault();
        
        var contentPad = document.getElementById('dashboardContentPad');
        contentPad.style.transform = 'translateY(' + pullOffset + 'px)';
        contentPad.classList.add('refreshing-content');
        
        this.ptrEl.style.transform = 'translateY(' + (pullOffset - 60) + 'px)';
        
        var percent = Math.min(1, pullOffset / this.pullThreshold);
        this.spinnerEl.style.opacity = percent;
        this.spinnerEl.style.transform = 'rotate(' + (percent * 360) + 'deg)';
      }
    },

    onTouchEnd: function(e) {
      if (!this.isPulling) return;
      this.isPulling = false;
      
      var contentPad = document.getElementById('dashboardContentPad');
      var deltaY = this.currentY - this.startY;
      var pullOffset = Math.min(this.pullMax, Math.pow(deltaY, 0.85));
      
      if (pullOffset >= this.pullThreshold) {
        this.triggerRefresh();
      } else {
        contentPad.style.transition = 'transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1)';
        this.ptrEl.style.transition = 'transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1)';
        contentPad.style.transform = '';
        this.ptrEl.style.transform = '';
        this.spinnerEl.style.opacity = '0';
      }
    },

    triggerRefresh: function() {
      this.isRefreshing = true;
      
      var contentPad = document.getElementById('dashboardContentPad');
      contentPad.style.transition = 'transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1)';
      this.ptrEl.style.transition = 'transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1)';
      
      contentPad.style.transform = 'translateY(40px)';
      this.ptrEl.style.transform = 'translateY(-20px)';
      
      this.spinnerEl.classList.add('active');
      this.spinnerEl.style.opacity = '1';
      this.spinnerEl.style.animation = 'iosSpin 1s linear infinite';
      
      var self = this;
      setTimeout(function() {
        self.completeRefresh();
      }, 1500);
    },

    completeRefresh: function() {
      var contentPad = document.getElementById('dashboardContentPad');
      contentPad.style.transition = 'transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1)';
      this.ptrEl.style.transition = 'transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1)';
      contentPad.style.transform = '';
      this.ptrEl.style.transform = '';
      
      this.spinnerEl.classList.remove('active');
      this.spinnerEl.style.animation = '';
      this.spinnerEl.style.opacity = '0';
      
      this.isRefreshing = false;
      
      initDashboard();
    }
  };
  /* ---------- Skin Image Analyzer (Client-Side Computer Vision) ---------- */
  var SkinAnalyzer = {
    analyze: function(photoDataURL, callback) {
      // Prototype random score generator for robust mobile execution
      var scoreVal = Math.floor(Math.random() * 21) + 74; // 74 to 94
      var hydrationVal = Math.floor(Math.random() * 21) + 70; // 70 to 90
      var textureVal = Math.floor(Math.random() * 21) + 70; // 70 to 90
      var poresVal = Math.floor(Math.random() * 21) + 70; // 70 to 90
      var rednessVal = Math.floor(Math.random() * 21) + 70; // 70 to 90
      
      var randomCoord = function(minX, maxX, minY, maxY) {
        return {
          x: Math.floor(Math.random() * (maxX - minX + 1)) + minX,
          y: Math.floor(Math.random() * (maxY - minY + 1)) + minY
        };
      };

      setTimeout(function() {
        callback({
          score: scoreVal,
          hydration: hydrationVal,
          texture: textureVal,
          pores: poresVal,
          redness: rednessVal,
          coords: {
            hydration: randomCoord(28, 42, 54, 66), // cheek area
            texture: randomCoord(58, 72, 34, 46),   // temple area
            pores: randomCoord(46, 54, 52, 60),     // nose area
            redness: randomCoord(42, 58, 26, 38)    // forehead area
          }
        });
      }, 50); // small delay to simulate processing
    }
  };

  /* ---------- Mascot SVG ---------- */
  var _mascotIdCounter = 0;
  function mascot(expr, idSuffix) {
    expr = expr || 'neutral';
    if (!idSuffix) { idSuffix = 'm' + (++_mascotIdCounter); }
    var g = function(id) { return id + '_' + idSuffix; };

    // Gradients and Filters
    var defs = '<defs>' +
      '<radialGradient id="' + g('blobinGrad3D') + '" cx="42%" cy="32%" r="68%" fx="38%" fy="28%">' +
        '<stop offset="0%" stop-color="#7dd3fc"/>' +
        '<stop offset="65%" stop-color="#38bdf8"/>' +
        '<stop offset="100%" stop-color="#225FC2"/>' +
      '</radialGradient>' +
      '<linearGradient id="' + g('glareGrad') + '" x1="0" y1="0" x2="1" y2="1">' +
        '<stop offset="0%" stop-color="rgba(255, 255, 255, 0.45)"/>' +
        '<stop offset="45%" stop-color="rgba(255, 255, 255, 0.1)"/>' +
        '<stop offset="100%" stop-color="rgba(255, 255, 255, 0)"/>' +
      '</linearGradient>' +
      '<clipPath id="' + g('lensClipLeft') + '">' +
        '<circle cx="83" cy="95" r="15"/>' +
      '</clipPath>' +
      '<clipPath id="' + g('lensClipRight') + '">' +
        '<circle cx="117" cy="95" r="15"/>' +
      '</clipPath>' +
      '<filter id="' + g('softShadow') + '" x="-15%" y="-15%" width="130%" height="130%">' +
        '<feDropShadow dx="0" dy="6" stdDeviation="6" flood-color="#000442" flood-opacity="0.14"/>' +
      '</filter>' +
    '</defs>';
    
    // 3D Pedestal Base (Stationary)
    var pedestalShadow = '<ellipse cx="100" cy="188" rx="66" ry="11" fill="#000442" opacity="0.08"/>';
    var pedestalBase = '<ellipse cx="100" cy="183" rx="66" ry="13.5" fill="#DCE6F5"/>'; // Bevel depth
    var pedestalTopRim = '<ellipse cx="100" cy="181" rx="66" ry="13.5" fill="#EFF5FD"/>';
    var pedestalTop = '<ellipse cx="100" cy="179" rx="66" ry="13" fill="#FFFFFF" stroke="#EFF5FD" stroke-width="0.5"/>';
    
    // Animated Cast Shadow of Blobin on top of the Pedestal
    var blobinShadow = '<ellipse class="blobin-pedestal-shadow" cx="100" cy="178" rx="38" ry="7.5" fill="#000442" opacity="0.14"/>';
    
    // Hands
    var handLeft = '';
    var handRight = '';
    
    // Reusable hand paths
    var leftUp    = '<path class="blobin-hand-left waving" d="M47,125 C32,120 22,105 28,92 C34,79 48,82 48,98 Z" fill="url(#' + g('blobinGrad3D') + ')" style="transform-origin: 45px 125px;"/>';
    var leftCheer = '<path class="blobin-hand-left" d="M50,120 C40,104 38,86 48,80 C58,74 62,90 58,104 Z" fill="url(#' + g('blobinGrad3D') + ')"/>';
    var leftHang  = '<path class="blobin-hand-left" d="M47,125 C32,128 24,142 28,155 C32,168 47,162 47,148 Z" fill="url(#' + g('blobinGrad3D') + ')"/>';
    var rightUp   = '<path class="blobin-hand-right" d="M153,125 C168,120 178,105 172,92 C166,79 152,82 152,98 Z" fill="url(#' + g('blobinGrad3D') + ')"/>';
    var rightCheer= '<path class="blobin-hand-right" d="M150,120 C160,104 162,86 152,80 C142,74 138,90 142,104 Z" fill="url(#' + g('blobinGrad3D') + ')"/>';
    var rightHang = '<path class="blobin-hand-right" d="M153,125 C168,128 176,142 172,155 C168,168 153,162 153,148 Z" fill="url(#' + g('blobinGrad3D') + ')"/>';
    var rightChin = '<path class="blobin-hand-right" d="M150,128 C150,138 138,124 122,122 C112,121 112,131 122,133 C134,135 140,140 150,140 Z" fill="url(#' + g('blobinGrad3D') + ')"/>';

    if (expr === 'excited' || expr === 'celebrate' || expr === 'surprised') {
      handLeft = leftCheer;
    } else if (expr === 'happy' || expr === 'wink' || expr === 'love' || expr === 'proud') {
      handLeft = leftUp;
    } else {
      handLeft = leftHang;
    }

    if (expr === 'excited' || expr === 'celebrate' || expr === 'surprised') {
      handRight = rightCheer;
    } else if (expr === 'thinking') {
      handRight = rightChin;
    } else {
      handRight = rightHang;
    }

    // Body path
    var body = '<path class="blobin-body" d="M100,38 C145,38 153,75 153,128 C153,168 143,178 128,178 C115,178 110,168 100,168 C90,168 85,178 72,178 C57,178 47,168 47,128 C47,75 55,38 100,38 Z" fill="url(#' + g('blobinGrad3D') + ')" filter="url(#' + g('softShadow') + ')"/>';
    
    // Cheeks
    var cheeks = '<ellipse cx="68" cy="107" rx="7" ry="4" fill="#E8B4A2" opacity="0.65"/>' +
                 '<ellipse cx="132" cy="107" rx="7" ry="4" fill="#E8B4A2" opacity="0.65"/>';
                 
    // Eyes
    var eyes = '';
    if (expr === 'wink') {
      // Left eye open
      eyes += '<g class="blobin-eyes blinkable">' +
        '<circle cx="83" cy="95" r="5.5" fill="#000442"/>' +
        '<circle cx="85" cy="93" r="1.8" fill="#fff"/>' +
      '</g>';
      // Right eye closed winking arc
      eyes += '<path d="M110,95 Q117,101 124,95" stroke="#000442" stroke-width="3.5" fill="none" stroke-linecap="round"/>';
    } else if (expr === 'happy') {
      // Curved happy eyes!
      eyes += '<path d="M76,97 Q83,89 90,97" stroke="#000442" stroke-width="3.5" fill="none" stroke-linecap="round"/>' +
              '<path d="M110,97 Q117,89 124,97" stroke="#000442" stroke-width="3.5" fill="none" stroke-linecap="round"/>';
    } else if (expr === 'sad' || expr === 'dry') {
      // Drooping sad/worried eyes
      eyes += '<g class="blobin-eyes">' +
        '<circle cx="83" cy="95" r="5.5" fill="#000442"/>' +
        '<circle cx="85" cy="93" r="1.8" fill="#fff"/>' +
        '<circle cx="117" cy="95" r="5.5" fill="#000442"/>' +
        '<circle cx="119" cy="93" r="1.8" fill="#fff"/>' +
        // Eyebrows tilted
        '<path d="M75,85 L87,89" stroke="#000442" stroke-width="2.5" stroke-linecap="round"/>' +
        '<path d="M125,85 L113,89" stroke="#000442" stroke-width="2.5" stroke-linecap="round"/>' +
      '</g>';
    } else if (expr === 'scanning') {
      // Focused scanning lines
      eyes += '<g class="blobin-eyes">' +
        '<line x1="75" y1="95" x2="91" y2="95" stroke="#000442" stroke-width="3.5" stroke-linecap="round"/>' +
        '<line x1="109" y1="95" x2="125" y2="95" stroke="#000442" stroke-width="3.5" stroke-linecap="round"/>' +
      '</g>';
    } else if (expr === 'excited' || expr === 'celebrate') {
      // Big sparkly eyes with star glints
      eyes += '<g class="blobin-eyes blinkable">' +
        '<circle cx="83" cy="95" r="6.5" fill="#000442"/>' +
        '<circle cx="85.5" cy="92.5" r="2.4" fill="#fff"/>' +
        '<circle cx="117" cy="95" r="6.5" fill="#000442"/>' +
        '<circle cx="119.5" cy="92.5" r="2.4" fill="#fff"/>' +
        '<path d="M67,79 l1.4,3 l3,1.4 l-3,1.4 l-1.4,3 l-1.4,-3 l-3,-1.4 l3,-1.4 Z" fill="#FFD066"/>' +
        '<path d="M134,81 l1.1,2.4 l2.4,1.1 l-2.4,1.1 l-1.1,2.4 l-1.1,-2.4 l-2.4,-1.1 l2.4,-1.1 Z" fill="#FFD066"/>' +
      '</g>';
    } else if (expr === 'surprised') {
      // Wide shocked eyes
      eyes += '<g class="blobin-eyes">' +
        '<circle cx="83" cy="95" r="8" fill="#fff" stroke="#000442" stroke-width="2.5"/>' +
        '<circle cx="83" cy="96" r="3.6" fill="#000442"/>' +
        '<circle cx="117" cy="95" r="8" fill="#fff" stroke="#000442" stroke-width="2.5"/>' +
        '<circle cx="117" cy="96" r="3.6" fill="#000442"/>' +
      '</g>';
    } else if (expr === 'love') {
      // Heart-shaped eyes
      eyes += '<g class="blobin-eyes">' +
        '<path d="M83,100 C77,94 73,90 77,86.5 C80.5,84 83,87.5 83,89.5 C83,87.5 85.5,84 89,86.5 C93,90 89,94 83,100 Z" fill="#FF5A7E"/>' +
        '<path d="M117,100 C111,94 107,90 111,86.5 C114.5,84 117,87.5 117,89.5 C117,87.5 119.5,84 123,86.5 C127,90 123,94 117,100 Z" fill="#FF5A7E"/>' +
      '</g>';
    } else if (expr === 'thinking') {
      // Eyes glancing up, one raised brow
      eyes += '<g class="blobin-eyes blinkable">' +
        '<circle cx="85" cy="92" r="5.5" fill="#000442"/>' +
        '<circle cx="87" cy="90" r="1.8" fill="#fff"/>' +
        '<circle cx="119" cy="92" r="5.5" fill="#000442"/>' +
        '<circle cx="121" cy="90" r="1.8" fill="#fff"/>' +
        '<path d="M75,84 Q83,80 91,83" stroke="#000442" stroke-width="2.5" fill="none" stroke-linecap="round"/>' +
      '</g>';
    } else if (expr === 'proud') {
      // Confident closed happy eyes
      eyes += '<path d="M76,96 Q83,90 90,96" stroke="#000442" stroke-width="3.5" fill="none" stroke-linecap="round"/>' +
              '<path d="M110,96 Q117,90 124,96" stroke="#000442" stroke-width="3.5" fill="none" stroke-linecap="round"/>';
    } else {
      // Normal open eyes
      eyes += '<g class="blobin-eyes blinkable">' +
        '<circle cx="83" cy="95" r="5.5" fill="#000442"/>' +
        '<circle cx="85" cy="93" r="1.8" fill="#fff"/>' +
        '<circle cx="117" cy="95" r="5.5" fill="#000442"/>' +
        '<circle cx="119" cy="93" r="1.8" fill="#fff"/>' +
      '</g>';
    }

    // Mouth
    var mouth = '';
    if (expr === 'happy') {
      // Wide open mouth
      mouth = '<path d="M91,110 Q100,124 109,110 Z" fill="#000442"/>';
    } else if (expr === 'sad' || expr === 'dry') {
      // Flipped sad curve
      mouth = '<path d="M93,116 Q100,108 107,116" stroke="#000442" stroke-width="3.5" fill="none" stroke-linecap="round"/>';
    } else if (expr === 'scanning') {
      // Simple small neutral mouth
      mouth = '<line x1="95" y1="113" x2="105" y2="113" stroke="#000442" stroke-width="3" stroke-linecap="round"/>';
    } else if (expr === 'excited' || expr === 'celebrate') {
      // Big open joyful grin with tongue
      mouth = '<path d="M87,108 Q100,129 113,108 Z" fill="#000442"/>' +
              '<path d="M94,120 Q100,126 106,120 Z" fill="#FF7B93"/>';
    } else if (expr === 'surprised') {
      // Small round O of shock
      mouth = '<ellipse cx="100" cy="116" rx="5.5" ry="6.5" fill="#000442"/>';
    } else if (expr === 'love') {
      // Open happy smile
      mouth = '<path d="M90,110 Q100,123 110,110 Z" fill="#000442"/>';
    } else if (expr === 'thinking') {
      // Pursed mouth pulled to one side
      mouth = '<path d="M94,114 Q101,111 107,115" stroke="#000442" stroke-width="3.5" fill="none" stroke-linecap="round"/>';
    } else if (expr === 'proud') {
      // Warm wide smile
      mouth = '<path d="M90,111 Q100,120 110,111" stroke="#000442" stroke-width="3.5" fill="none" stroke-linecap="round"/>';
    } else {
      // Default cute smile
      mouth = '<path d="M92,111 Q100,118 108,111" stroke="#000442" stroke-width="3.5" fill="none" stroke-linecap="round"/>';
    }

    // Glasses or Sunglasses
    var glasses = '';
    if (expr === 'sunny') {
      // Cool dark sunglasses!
      glasses = '<g class="blobin-sunglasses">' +
        '<path d="M63,95 C63,83 100,83 100,95 C100,83 137,83 137,95 C137,107 100,107 100,95 C100,107 63,107 63,95 Z" fill="#000442" filter="url(#' + g('softShadow') + ')"/>' +
        '<path d="M68,90 L85,102" stroke="rgba(255,255,255,0.4)" stroke-width="2.5" stroke-linecap="round"/>' +
        '<path d="M105,90 L122,102" stroke="rgba(255,255,255,0.4)" stroke-width="2.5" stroke-linecap="round"/>' +
        // Glasses temples
        '<path d="M63,95 Q52,95 47,99" fill="none" stroke="#000442" stroke-width="3" stroke-linecap="round"/>' +
        '<path d="M137,95 Q148,95 153,99" fill="none" stroke="#000442" stroke-width="3" stroke-linecap="round"/>' +
      '</g>';
    } else {
      // Normal round glasses (Mascot character description: "The Blobin Guide with round glasses")
      glasses = '<g class="blobin-glasses">' +
        // Temples
        '<path d="M67,95 Q55,95 48,100" fill="none" stroke="#D6AF98" stroke-width="3.2" stroke-linecap="round"/>' +
        '<path d="M133,95 Q145,95 152,100" fill="none" stroke="#D6AF98" stroke-width="3.2" stroke-linecap="round"/>' +
        // Left rim fill (Hydration Blue translucent)
        '<circle cx="83" cy="95" r="16.5" fill="rgba(181, 222, 232, 0.22)" stroke="#D6AF98" stroke-width="3.2"/>' +
        // Right rim fill (Hydration Blue translucent)
        '<circle cx="117" cy="95" r="16.5" fill="rgba(181, 222, 232, 0.22)" stroke="#D6AF98" stroke-width="3.2"/>' +
        // Glare shimmers inside the lenses
        '<g clip-path="url(#' + g('lensClipLeft') + ')">' +
          '<path class="blobin-glare" d="M 50 60 L 75 60 L 45 130 L 20 130 Z" fill="url(#' + g('glareGrad') + ')"/>' +
        '</g>' +
        '<g clip-path="url(#' + g('lensClipRight') + ')">' +
          '<path class="blobin-glare" d="M 84 60 L 109 60 L 79 130 L 54 130 Z" fill="url(#' + g('glareGrad') + ')"/>' +
        '</g>' +
        // Bridge
        '<path d="M99,95 L101,95" fill="none" stroke="#D6AF98" stroke-width="3.2" stroke-linecap="round"/>' +
      '</g>';
    }

    // Combine into SVG string
    return '<svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" class="blobin-mascot-svg">' +
      defs +
      pedestalShadow +
      pedestalBase +
      pedestalTopRim +
      pedestalTop +
      blobinShadow +
      '<g class="blobin-character">' +
        '<g class="blobin-hand-left-wrap">' + handLeft + '</g>' +
        '<g class="blobin-hand-right-wrap">' + handRight + '</g>' +
        body +
        cheeks +
        '<g class="blobin-eyes-wrap">' + eyes + '</g>' +
        '<g class="blobin-mouth-wrap">' + mouth + '</g>' +
        glasses +
      '</g>' +
    '</svg>';
  }

  function setMascotExpression(containerEl, expr) {
    if (!containerEl) return;
    var tempDiv = document.createElement('div');
    tempDiv.innerHTML = mascot(expr);
    var newEyes = tempDiv.querySelector('.blobin-eyes-wrap');
    var newMouth = tempDiv.querySelector('.blobin-mouth-wrap');
    
    var currentEyes = containerEl.querySelector('.blobin-eyes-wrap');
    var currentMouth = containerEl.querySelector('.blobin-mouth-wrap');
    
    if (currentEyes && newEyes) currentEyes.innerHTML = newEyes.innerHTML;
    if (currentMouth && newMouth) currentMouth.innerHTML = newMouth.innerHTML;
  }
  var tm = document.getElementById('tipMascot');
  if (tm) tm.innerHTML = mascot('sunny');
  var navMascotEl = document.getElementById('navMascotIcon');
  if (navMascotEl) { navMascotEl.innerHTML = mascot('happy'); }



  /* ---------- Storage Manager ---------- */
  var StorageManager = {
    KEY_SCANS: 'skin_scan_history',
    KEY_QUIZ: 'skin_scan_quiz',
    KEY_ROUTINE: 'skin_scan_routine_checkboxes',

    getScanBalance: function() {
      var bal = localStorage.getItem('glowo_scan_balance');
      if (bal === null) return 0;
      var parsed = parseInt(bal, 10);
      return isNaN(parsed) ? 0 : parsed;
    },

    setScanBalance: function(val) {
      localStorage.setItem('glowo_scan_balance', val.toString());
      if (typeof SubscriptionManager !== 'undefined') {
        SubscriptionManager.applySubscriptionUI();
      }
      if (typeof renderSettings === 'function') {
        renderProfileScreen();
      }
    },

    addScans: function(count) {
      this.setScanBalance(this.getScanBalance() + count);
    },

    decrementScanBalance: function() {
      var bal = this.getScanBalance();
      if (bal > 0) {
        this.setScanBalance(bal - 1);
        return true;
      }
      return false;
    },

    getHistory: function() {
      var data = localStorage.getItem(this.KEY_SCANS);
      if (!data) {
        return [];
      }
      try {
        return JSON.parse(data);
      } catch (e) {
        return [];
      }
    },

    saveScan: function(scan) {
      var history = this.getHistory();
      var existingIndex = -1;
      for (var i = 0; i < history.length; i++) {
        if (history[i].id === scan.id) {
          existingIndex = i;
          break;
        }
      }
      if (existingIndex > -1) {
        history[existingIndex] = scan;
      } else {
        history.push(scan);
      }
      localStorage.setItem(this.KEY_SCANS, JSON.stringify(history));
    },

    getStreak: function() {
      var history = this.getHistory();
      if (history.length === 0) return 0;
      
      var datesSet = {};
      history.forEach(function(s) {
        var date = new Date(s.id);
        var yyyy = date.getFullYear();
        var mm = String(date.getMonth() + 1).padStart(2, '0');
        var dd = String(date.getDate()).padStart(2, '0');
        datesSet[yyyy + '-' + mm + '-' + dd] = true;
      });
      
      var dates = Object.keys(datesSet).sort(function(a, b) {
        return b.localeCompare(a);
      });
      
      if (dates.length === 0) return 0;
      
      var getLocalDateString = function(date) {
        var yyyy = date.getFullYear();
        var mm = String(date.getMonth() + 1).padStart(2, '0');
        var dd = String(date.getDate()).padStart(2, '0');
        return yyyy + '-' + mm + '-' + dd;
      };
      
      var todayStr = getLocalDateString(new Date());
      
      var yesterday = new Date();
      yesterday.setDate(yesterday.getDate() - 1);
      var yesterdayStr = getLocalDateString(yesterday);
      
      if (dates[0] !== todayStr && dates[0] !== yesterdayStr) {
        return 0;
      }
      
      var streak = 1;
      var currentDate = new Date(dates[0] + 'T00:00:00');
      
      for (var i = 1; i < dates.length; i++) {
        var expectedPrevDate = new Date(currentDate);
        expectedPrevDate.setDate(expectedPrevDate.getDate() - 1);
        var expectedPrevStr = getLocalDateString(expectedPrevDate);
        
        if (dates[i] === expectedPrevStr) {
          streak++;
          currentDate = expectedPrevDate;
        } else {
          break;
        }
      }
      
      return streak;
    },

    getLessonStreak: function() {
      var lessonDates = JSON.parse(localStorage.getItem('glowo_lesson_dates') || '[]');
      if (lessonDates.length === 0) return 0;
      var fmt = function(d) {
        return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
      };
      var dateSet = {};
      lessonDates.forEach(function(d) { dateSet[d] = true; });
      var todayStr = fmt(new Date());
      var yest = new Date(); yest.setDate(yest.getDate()-1);
      if (!dateSet[todayStr] && !dateSet[fmt(yest)]) return 0;
      var streak = 0;
      var cur = new Date();
      while (dateSet[fmt(cur)]) { streak++; cur.setDate(cur.getDate()-1); }
      return streak;
    },

    getWeeklyScanStatus: function() {
      var history = this.getHistory();
      var scanDates = {};
      history.forEach(function(s) {
        var d = new Date(s.id);
        var yyyy = d.getFullYear();
        var mm = String(d.getMonth() + 1).padStart(2, '0');
        var dd = String(d.getDate()).padStart(2, '0');
        scanDates[yyyy + '-' + mm + '-' + dd] = true;
      });
      
      var today = new Date();
      var day = today.getDay();
      var diff = today.getDate() - day + (day === 0 ? -6 : 1);
      var monday = new Date(today.setDate(diff));
      
      var weekStatus = [];
      var dayNames = ['M', 'T', 'W', 'T', 'F', 'S', 'S'];
      
      for (var i = 0; i < 7; i++) {
        var d = new Date(monday);
        d.setDate(monday.getDate() + i);
        
        var yyyy = d.getFullYear();
        var mm = String(d.getMonth() + 1).padStart(2, '0');
        var dd = String(d.getDate()).padStart(2, '0');
        var dateStr = yyyy + '-' + mm + '-' + dd;
        
        var isToday = (yyyy + '-' + mm + '-' + dd) === (function() {
          var t = new Date();
          return t.getFullYear() + '-' + String(t.getMonth() + 1).padStart(2, '0') + '-' + String(t.getDate()).padStart(2, '0');
        })();
        
        weekStatus.push({
          dayName: dayNames[i],
          dateLabel: d.getDate(),
          isScanned: !!scanDates[dateStr],
          isToday: isToday
        });
      }
      
      return weekStatus;
    },

    getWeeklyLessonStatus: function() {
      var lessonDates = JSON.parse(localStorage.getItem('glowo_lesson_dates') || '[]');
      var dateSet = {};
      lessonDates.forEach(function(d) { dateSet[d] = true; });

      var today = new Date();
      var day = today.getDay();
      var diff = today.getDate() - day + (day === 0 ? -6 : 1);
      var monday = new Date(today); monday.setDate(diff);

      var weekStatus = [];
      var dayNames = ['M','T','W','T','F','S','S'];
      for (var i = 0; i < 7; i++) {
        var d = new Date(monday); d.setDate(monday.getDate() + i);
        var yyyy = d.getFullYear();
        var mm = String(d.getMonth()+1).padStart(2,'0');
        var dd = String(d.getDate()).padStart(2,'0');
        var dateStr = yyyy + '-' + mm + '-' + dd;
        var todayStr = (function() {
          var t = new Date();
          return t.getFullYear() + '-' + String(t.getMonth()+1).padStart(2,'0') + '-' + String(t.getDate()).padStart(2,'0');
        })();
        weekStatus.push({ dayName: dayNames[i], dateLabel: d.getDate(), isScanned: !!dateSet[dateStr], isToday: dateStr === todayStr });
      }
      return weekStatus;
    },

    hasScannedToday: function() {
      if (localStorage.getItem('skin_scan_bypass_cooldown') === 'true') {
        return false;
      }
      var history = this.getHistory();
      if (history.length === 0) return false;
      
      var todayStr = new Date().toDateString();
      for (var i = 0; i < history.length; i++) {
        var scanDate = new Date(history[i].id).toDateString();
        if (scanDate === todayStr) {
          return true;
        }
      }
      return false;
    },

    clearHistory: function() {
      localStorage.removeItem(this.KEY_SCANS);
    },

    getQuizResult: function() {
      return localStorage.getItem(this.KEY_QUIZ);
    },

    saveQuizResult: function(result) {
      localStorage.setItem(this.KEY_QUIZ, result);
    },

    getRoutineState: function() {
      var state = localStorage.getItem(this.KEY_ROUTINE);
      return state ? JSON.parse(state) : {};
    },

    saveRoutineState: function(state) {
      localStorage.setItem(this.KEY_ROUTINE, JSON.stringify(state));
    }
  };

  /* ---------- Animated score ring ---------- */
  function ringMarkup(size, stroke){
    size = size || 110; stroke = stroke || 11;
    var radius = (size/2) - stroke;
    var circumference = 2*Math.PI*radius;
    return '<svg width="'+size+'" height="'+size+'" viewBox="0 0 '+size+' '+size+'" data-circumference="'+circumference+'">' +
      '<circle cx="'+(size/2)+'" cy="'+(size/2)+'" r="'+radius+'" fill="none" stroke="#E3ECFB" stroke-width="'+stroke+'"/>' +
      '<circle class="ring-progress" cx="'+(size/2)+'" cy="'+(size/2)+'" r="'+radius+'" fill="none" stroke="#38bdf8" stroke-width="'+stroke+'" stroke-linecap="round" stroke-dasharray="'+circumference+'" stroke-dashoffset="'+circumference+'" transform="rotate(-90 '+(size/2)+' '+(size/2)+')"/>' +
      '<text class="ring-num" x="50%" y="45%" text-anchor="middle" dominant-baseline="middle" font-size="'+(size*0.30)+'" font-weight="700" fill="#15203C" font-family="Quicksand,sans-serif">0</text>' +
      '<text x="50%" y="65%" text-anchor="middle" dominant-baseline="middle" font-size="'+(size*0.105)+'" fill="#6B7A99" font-family="Nunito,sans-serif">/100</text>' +
    '</svg>';
  }
  function setRing(containerEl, score, size, stroke){
    containerEl.innerHTML = ringMarkup(size, stroke);
    var circle = containerEl.querySelector('.ring-progress');
    var numEl = containerEl.querySelector('.ring-num');
    var circumference = parseFloat(containerEl.querySelector('svg').getAttribute('data-circumference'));
    requestAnimationFrame(function(){
      requestAnimationFrame(function(){
        circle.style.transition = 'stroke-dashoffset 1s cubic-bezier(.22,1,.36,1)';
        circle.style.strokeDashoffset = circumference * (1 - score/100);
      });
    });
    var start = null, duration = 1000;
    function step(ts){
      if(!start){ start = ts; }
      var progress = Math.min((ts - start)/duration, 1);
      numEl.textContent = Math.round(progress * score);
      if(progress < 1){ requestAnimationFrame(step); }
    }
    requestAnimationFrame(step);
  }

  /* ---------- Dashboard Init ---------- */
  function initDashboard() {
    var history = StorageManager.getHistory();
    
    // Update streak counter
    var streak = StorageManager.getStreak();
    var streakCountEl = document.getElementById('dashboardStreakCount');
    var streakPillEl = document.getElementById('dashboardStreakPill');
    if (streakCountEl && streakPillEl) {
      streakCountEl.textContent = streak;
      if (streak > 0) {
        streakPillEl.classList.remove('inactive');
      } else {
        streakPillEl.classList.add('inactive');
      }
    }
    
    var lessonStreak = StorageManager.getLessonStreak();
    var homeStreakText = document.getElementById('homeStreakText');
    if (homeStreakText) {
      homeStreakText.textContent = lessonStreak;
    }


    var weeklyStatus = StorageManager.getWeeklyLessonStatus();
    var homeCalendarDaysList = document.getElementById('homeCalendarDaysList');
    if (homeCalendarDaysList) {
      homeCalendarDaysList.innerHTML = weeklyStatus.map(function(day) {
        var circleClass = 'calendar-day-circle';
        if (day.isScanned) circleClass += ' scanned';
        if (day.isToday) circleClass += ' today';
        var content = day.isScanned ? '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>' : day.dateLabel;
        return '<div class="calendar-day-item' + (day.isToday ? ' today' : '') + '">' +
                 '<div class="' + circleClass + '">' + content + '</div>' +
                 '<span class="calendar-day-label">' + day.dayName + '</span>' +
               '</div>';
      }).join('');
    }
    
    var latest = history[history.length - 1];
    
    var badge = document.getElementById('homeFreeScanBadge');
    if (badge) {
      badge.style.display = firstScanDone ? 'none' : 'inline-flex';
    }
    
    var userName = localStorage.getItem('skin_scan_user_name') || 'Guest';
    var greetingNameEl = document.querySelector('#screen-dashboard .home-header h1.display-name');
    if (greetingNameEl) {
      greetingNameEl.textContent = userName + '!';
    }

    var userEmail = localStorage.getItem('skin_scan_user_email') || 'guest@email.com';
    if (false) { // legacy profile selectors removed — now handled by renderProfileScreen
      var _unused = userEmail;
    }
    
    var homeScore  = document.getElementById('homeHeroScore');
    var homeDelta  = document.getElementById('homeHeroDelta');
    var homeSub    = document.getElementById('homeHeroSub');
    var homeArc    = document.getElementById('homeHeroRingArc');
    var homePct    = document.getElementById('homeHeroRingPct');
    var circ = 213.6;
    if (latest) {
      var scans = StorageManager.getHistory().slice().sort(function(a,b){return b.id-a.id;});
      var prev  = scans.length > 1 ? scans[1].score : latest.score;
      var delta = latest.score - prev;
      if (homeScore) homeScore.textContent = latest.score;
      if (homeDelta) {
        homeDelta.textContent = (delta >= 0 ? '↑ +' : '↓ ') + delta + ' pts';
        homeDelta.style.background = delta >= 0 ? 'rgba(30,158,107,0.28)' : 'rgba(214,83,109,0.28)';
        homeDelta.style.display = scans.length > 1 ? '' : 'none';
      }
      if (homeSub) homeSub.textContent = latest.headline;
      if (homeArc) {
        homeArc.style.transition = 'none';
        homeArc.style.strokeDashoffset = circ;
        setTimeout(function() {
          homeArc.style.transition = 'stroke-dashoffset 1.4s cubic-bezier(0.22,1,0.36,1)';
          homeArc.style.strokeDashoffset = circ * (1 - latest.score / 100);
        }, 300);
      }
      if (homePct) homePct.textContent = latest.score + '%';
    } else {
      if (homeScore) homeScore.textContent = '—';
      if (homeDelta) homeDelta.style.display = 'none';
      if (homeSub)   homeSub.textContent = 'Take your first scan to see your score';
      if (homeArc)   homeArc.style.strokeDashoffset = circ;
      if (homePct)   homePct.textContent = '—';
    }
    
    updateDashboardMessage();
    document.getElementById('dashboardMascot').innerHTML = mascot('wink');
    DailyQuests.render();
    RoutineCard.render();
    WaterCard.render();
  }

  /* ── Daily Quest Engine (single rotating quest) ── */
  var DailyQuests = (function() {
    var KEY = 'glowo_daily_quests';

    function todayStr() {
      var d = new Date();
      return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
    }

    // Seed by date so quest changes each day but is stable within a day
    function dateHash() {
      var d = todayStr(); var n = 0;
      for (var i = 0; i < d.length; i++) n += d.charCodeAt(i);
      return n;
    }

    var QUEST_POOL = [
      {
        id: 'routine',
        name: 'Morning Shield',
        sub: 'Complete your AM routine checklist',
        iconBg: 'rgba(245,166,35,0.15)',
        icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="#F5A623"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>',
        xp: 10, total: 1
      },
      {
        id: 'lesson',
        name: 'Deep Learner',
        sub: 'Complete 1 skincare lesson node',
        iconBg: 'rgba(124,58,237,0.15)',
        icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="#7C3AED"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>',
        xp: 15, total: 1
      },
      {
        id: 'water',
        name: 'Stay Hydrated',
        sub: 'Log 8 glasses of water (2L)',
        iconBg: 'rgba(26,125,232,0.15)',
        icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="#1A7DE8"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>',
        xp: 10, total: 8
      }
    ];

    function pickQuest() {
      return QUEST_POOL[dateHash() % QUEST_POOL.length];
    }

    function getState() {
      try {
        var raw = JSON.parse(localStorage.getItem(KEY) || 'null');
        var today = todayStr();
        var q = pickQuest();
        if (!raw || raw.date !== today) {
          raw = { date: today, water: 0, lessonDone: false, routineDone: false, questId: q.id, xpGiven: false };
          localStorage.setItem(KEY, JSON.stringify(raw));
        }
        if (!raw.questId) { raw.questId = q.id; saveState(raw); }
        return raw;
      } catch(e) {
        var q2 = pickQuest();
        return { date: todayStr(), water: 0, lessonDone: false, routineDone: false, questId: q2.id, xpGiven: false };
      }
    }

    function saveState(s) { localStorage.setItem(KEY, JSON.stringify(s)); }

    function awardXP(amount) {
      if (typeof LessonEngine === 'undefined') return;
      var p = LessonEngine.getProgress();
      p.xp = (p.xp || 0) + amount;
      LessonEngine.saveProgress(p);
      if (typeof MetricsBar !== 'undefined') {
        MetricsBar.update('xp', p.xp);
        MetricsBar.update('energy', p.xp);
      } else {
        var xv = document.getElementById('learnXpVal'); if (xv) xv.textContent = p.xp;
        var ev = document.getElementById('learnEnergyVal'); if (ev) ev.textContent = p.xp;
      }
    }

    function timeUntilMidnight() {
      var now = new Date();
      var msLeft = new Date(now.getFullYear(), now.getMonth(), now.getDate()+1) - now;
      var h = Math.floor(msLeft/3600000), m = Math.floor((msLeft%3600000)/60000);
      return h + 'h ' + m + 'm';
    }

    function getQuestProgress(s, q) {
      if (q.id === 'routine') return { current: s.routineDone ? 1 : 0, done: !!s.routineDone };
      if (q.id === 'lesson') {
        var lp = (typeof LessonEngine !== 'undefined') ? LessonEngine.getProgress() : {};
        var done = lp.lastLessonDate === todayStr() || !!s.lessonDone;
        return { current: done ? 1 : 0, done: done };
      }
      if (q.id === 'water') {
        var w = Math.min(s.water || 0, 8);
        return { current: w, done: w >= 8 };
      }
      return { current: 0, done: false };
    }

    var XP_ICON = '<svg width="11" height="11" viewBox="0 0 24 24" fill="#F5A623"><circle cx="12" cy="12" r="4"/><path d="M12 2v3M12 19v3M4.22 4.22l2.12 2.12M17.66 17.66l2.12 2.12M2 12h3M19 12h3M4.22 19.78l2.12-2.12M17.66 6.34l2.12-2.12" stroke="#F5A623" stroke-width="2" stroke-linecap="round"/></svg>';
    var CHECK_HTML = '<div class="dq-done-check"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></div>';

    // Side-effecting: grants XP and persists state when the quest is newly done.
    // Kept OUT of render() so rendering stays idempotent — call this from the
    // actual completion events instead. Safe to call repeatedly (guarded by xpGiven).
    function syncRewards() {
      var s = getState();
      var q = pickQuest();
      var prog = getQuestProgress(s, q);
      if (prog.done && !s.xpGiven) { awardXP(q.xp); s.xpGiven = true; saveState(s); }
      if (q.id === 'lesson' && prog.done && !s.lessonDone) { s.lessonDone = true; saveState(s); }
    }

    function render() {
      syncRewards();
      var s = getState();
      var q = pickQuest();
      var prog = getQuestProgress(s, q);

      // Update reset label
      var label = document.getElementById('dqResetLabel');
      if (label) label.textContent = 'Resets in ' + timeUntilMidnight();

      // Build/update the slot HTML
      var slot = document.getElementById('dqQuestSlot');
      if (!slot) return;
      var pct = Math.min(100, (prog.current / q.total) * 100);
      var rewardHTML = prog.done
        ? CHECK_HTML
        : '<div class="dq-reward" id="dqReward-active">' + XP_ICON + ' +' + q.xp + ' XP</div>';
      slot.innerHTML =
        '<div class="dq-quest' + (prog.done ? ' dq-done' : '') + '" id="dqQuest-active">' +
          '<div class="dq-quest-top">' +
            '<div class="dq-quest-left">' +
              '<div class="dq-quest-icon" style="background:' + q.iconBg + ';">' + q.icon + '</div>' +
              '<div>' +
                '<p class="dq-quest-name">' + q.name + '</p>' +
                '<p class="dq-quest-sub">' + q.sub + '</p>' +
              '</div>' +
            '</div>' +
            rewardHTML +
          '</div>' +
          '<div class="dq-progress-wrap">' +
            '<div class="dq-bar-bg"><div class="dq-bar-fill' + (prog.done ? ' complete' : '') + '" id="dqBar-active" style="width:' + pct + '%"></div></div>' +
            '<span class="dq-count" id="dqCount-active">' + prog.current + '/' + q.total + '</span>' +
          '</div>' +
        '</div>';
    }

    function markRoutineDone() {
      var s = getState();
      if (!s.routineDone) { s.routineDone = true; saveState(s); }
      render();
    }

    function addWater(n) {
      var s = getState();
      s.water = Math.min(8, (s.water || 0) + n);
      saveState(s);
      render();
    }

    return { render: render, syncRewards: syncRewards, getState: getState, markRoutineDone: markRoutineDone, addWater: addWater };
  })();

  /* ── Routine Card ── */
  var RoutineCard = (function() {
    var KEY = 'glowo_routine_card';

    function todayStr() {
      var d = new Date();
      return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
    }

    function getState() {
      try {
        var raw = JSON.parse(localStorage.getItem(KEY) || 'null');
        if (!raw || raw.date !== todayStr()) {
          raw = { date: todayStr(), am: false, pmclean: false, pmmoiss: false };
          localStorage.setItem(KEY, JSON.stringify(raw));
        }
        return raw;
      } catch(e) { return { date: todayStr(), am: false, pmclean: false, pmmoiss: false }; }
    }

    function saveState(s) { localStorage.setItem(KEY, JSON.stringify(s)); }

    function applyItem(key, checked) {
      var item  = document.getElementById('routineItem-'  + key);
      var check = document.getElementById('routineCheck-' + key);
      var svg   = document.getElementById('routineCheckSvg-' + key);
      if (!item) return;
      if (checked) {
        item.classList.add('checked');
        if (check) check.style.background = '';
        if (svg)   svg.style.display = 'block';
      } else {
        item.classList.remove('checked');
        if (svg) svg.style.display = 'none';
      }
    }

    function render() {
      var s = getState();
      ['am','pmclean','pmmoiss'].forEach(function(k) { applyItem(k, s[k]); });

      ['am','pmclean','pmmoiss'].forEach(function(key) {
        var item = document.getElementById('routineItem-' + key);
        if (!item || item._rcBound) return;
        item._rcBound = true;
        item.addEventListener('click', function() {
          SFX.check();
          if (window.webkit && window.webkit.messageHandlers && window.webkit.messageHandlers.hapticSelection) {
            window.webkit.messageHandlers.hapticSelection.postMessage(null);
          }
          var st = getState();
          st[key] = !st[key];
          saveState(st);
          applyItem(key, st[key]);
          if (st[key] && typeof DailyQuests !== 'undefined') {
            var dqState = DailyQuests.getState();
            if (dqState.questId === 'routine') DailyQuests.markRoutineDone();
          }
        });
      });
    }

    return { render: render };
  })();

  /* ── Water Tracker Card ── */
  var WaterCard = (function() {
    var TOTAL = 8;
    function render() {
      var s = (typeof DailyQuests !== 'undefined') ? DailyQuests.getState() : { water: 0 };
      var count = Math.min(s.water || 0, TOTAL);
      var label = document.getElementById('waterLabel');
      if (label) label.textContent = 'Logged: ' + count + ' / ' + TOTAL + ' glasses';
      var bar = document.getElementById('waterBarFill');
      if (bar) bar.style.width = Math.round((count / TOTAL) * 100) + '%';
      // animate the SVG fill rect: map count to height inside the glass (48px max fill area)
      var fillRect = document.getElementById('waterFillRect');
      if (fillRect) {
        var fillH = Math.round((count / TOTAL) * 48);
        fillRect.setAttribute('y', 52 - fillH);
        fillRect.setAttribute('height', fillH);
      }
      var btn = document.getElementById('waterCircleBtn');
      if (btn && !btn._wcBound) {
        btn._wcBound = true;
        btn.addEventListener('click', function() {
          if (typeof DailyQuests === 'undefined') return;
          var st = DailyQuests.getState();
          if ((st.water || 0) >= TOTAL) return;
          SFX.water();
          if (window.webkit && window.webkit.messageHandlers && window.webkit.messageHandlers.hapticSelection) {
            window.webkit.messageHandlers.hapticSelection.postMessage(null);
          }
          DailyQuests.addWater(1);
          WaterCard.render();
        });
      }
    }
    return { render: render };
  })();

  /* ---------- Analysis profiles ---------- */
  var PROFILES = [
    {
      score: 82, headline: "Glowing &amp; Balanced",

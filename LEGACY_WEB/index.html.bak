  <!-- PROFILE -->
  <section class="screen" id="screen-profile">
    <div class="prof-scroll-wrap">
    <div class="prof-pad">

      <!-- ── 1. Progress Header ── -->
      <div class="prof-card fade-item" style="animation-delay:.04s">
        <div class="prof-header-row">
          <div class="prof-avatar">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="#38bdf8">
              <path d="M12 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10zm-7 9a7 7 0 1 1 14 0H5z"/>
            </svg>
          </div>

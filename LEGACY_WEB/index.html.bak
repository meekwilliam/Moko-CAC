var ALL_LESSONS_DATA = [].concat(WELCOME_DATA, UNIT_1_DATA, UNIT_2_DATA, UNIT_3_DATA, UNIT_4_DATA, SECTION_2_UNIT_1_DATA, SECTION_2_UNIT_2_DATA, SECTION_3_UNIT_1_DATA, SECTION_3_UNIT_2_DATA);


/* Maps a lesson node number to its unit "focus" label for the top context banner */
function lessonUnitFocus(nodeNum) {
  if (nodeNum <= 5)  return 'SECTION 1 · SKINCARE FOUNDATIONS';
  if (nodeNum <= 10) return 'SECTION 2 · KNOW YOUR SKIN';
  if (nodeNum <= 15) return 'SECTION 3 · ACTIVE INGREDIENTS';
  if (nodeNum <= 20) return 'SECTION 4 · SKIN CONDITIONS';
  if (nodeNum <= 25) return 'SECTION 5 · ADVANCED HABITS';
  if (nodeNum <= 30) return 'SECTION 6 · WEATHER & CLIMATE';
  if (nodeNum <= 35) return 'SECTION 7 · PRODUCT LABELS';
  if (nodeNum <= 40) return 'SECTION 8 · SCIENCE OF ELASTICITY';
  if (nodeNum <= 45) return 'SECTION 9 · SKIN-BODY CONNECTION';
  return 'SKINCARE SCIENCE';
}

/* Maps a lesson node to its active unit color (main + darker bevel shade) so the
   lesson view's progress bar and 3D action button match the unit's theme. */
function lessonUnitColor(nodeNum) {
  if (nodeNum <= 5)  return { main:'#38bdf8', dark:'#0c4a6e' };
  if (nodeNum <= 10) return { main:'#14B8A6', dark:'#0F766E' };
  if (nodeNum <= 15) return { main:'#7C3AED', dark:'#4C1D95' };
  if (nodeNum <= 20) return { main:'#10B981', dark:'#047857' };
  if (nodeNum <= 25) return { main:'#F59E0B', dark:'#B45309' };
  if (nodeNum <= 30) return { main:'#0891b2', dark:'#0e4a6e' };
  if (nodeNum <= 35) return { main:'#4f46e5', dark:'#3730a3' };
  if (nodeNum <= 40) return { main:'#db2777', dark:'#9d174d' };
  return { main:'#ea580c', dark:'#c2410c' };
}

/* Chunky, beveled game-style hearts for the lesson health bar. */
function lessonHeartsHTML(lives) {
  var path = 'M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z';
  var h = '';
  for (var i = 0; i < 3; i++) {
    var on = i < lives;
    h += '<svg class="lesson-heart' + (on ? '' : ' empty') + '" width="26" height="26" viewBox="0 0 24 24">' +
      '<path d="' + path + '" fill="' + (on ? '#FF4D6D' : 'rgba(150,160,185,0.22)') + '" stroke="' + (on ? '#B3203D' : 'rgba(120,132,160,0.5)') + '" stroke-width="1.6" stroke-linejoin="round"/></svg>';
  }
  return h;
}

/* Vector icon for the intro concept card (signals an objective educational definition) */
var LESSON_CONCEPT_ICON = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 7v13"/><path d="M3 5.5A2.5 2.5 0 0 1 5.5 3H12v15.5H5.5A2.5 2.5 0 0 0 3 21V5.5z"/><path d="M21 5.5A2.5 2.5 0 0 0 18.5 3H12v15.5h6.5a2.5 2.5 0 0 1 2.5 2.5V5.5z"/></svg>';

/* ---------- Lesson Engine ---------- */
var LessonEngine = {
  currentNode: null,
  currentScreen: 0,
  answered: false,
  selectedAnswer: null,
  matchState: null,
  dragOrder: null,
  lives: 3,

  getProgress: function() {
    try { return JSON.parse(localStorage.getItem('glowo_lesson_progress') || '{"completed":[],"xp":0}'); } catch(e) { return {completed:[], xp:0}; }
  },

  saveProgress: function(p) {
    try { localStorage.setItem('glowo_lesson_progress', JSON.stringify(p)); } catch(e) {}
  },

  isCompleted: function(nodeNum) {
    return this.getProgress().completed.indexOf(nodeNum) > -1;
  },

  saveInProgress: function() {
    if (!this.currentNode) return;
    try { localStorage.setItem('glowo_lesson_inprogress', JSON.stringify({
      node: this.currentNode.node,
      screen: this.currentScreen
    })); } catch(e) {}
  },

  clearInProgress: function() {
    localStorage.removeItem('glowo_lesson_inprogress');
  },

  open: function(nodeNum) {
    var nodeData = ALL_LESSONS_DATA.filter(function(d) { return d.node === nodeNum; })[0];
    if (!nodeData) return;
    this.currentNode = nodeData;
    this.lives = 3;
    this.isComplete = false;
    // Resume from saved screen if available
    var saved = null;
    try { saved = JSON.parse(localStorage.getItem('glowo_lesson_inprogress')); } catch(e) {}
    this.currentScreen = (saved && saved.node === nodeNum && saved.screen > 0) ? saved.screen : 0;
    var overlay = document.getElementById('lessonOverlay');
    // Theme the lesson view (progress bar + action button) with the active unit color
    var uc = lessonUnitColor(nodeNum);
    overlay.style.setProperty('--lesson-unit', uc.main);
    overlay.style.setProperty('--lesson-unit-dark', uc.dark);
    overlay.style.display = 'flex';
    requestAnimationFrame(function() { requestAnimationFrame(function() { overlay.classList.add('open'); }); });
    LessonEngine.renderScreen();
  },

  close: function() {
    var overlay = document.getElementById('lessonOverlay');
    overlay.classList.remove('open');
    setTimeout(function() { overlay.style.display = 'none'; }, 350);
    renderProgressScreen();
  },

  renderScreen: function() {
    var screens = this.currentNode.screens;
    var screen = screens[this.currentScreen];
    // Fill grows with the current screen index (e.g. screen 1 of 5); 100% reserved for completion.
    var pct = ((this.currentScreen + 1) / (screens.length + 1)) * 100;
    document.getElementById('lessonProgressFill').style.width = pct + '%';
    this.answered = false;
    this.selectedAnswer = null;
    this.matchState = null;

    var titleEl = document.getElementById('lessonUnitTitle');
    if (titleEl) titleEl.textContent = lessonUnitFocus(this.currentNode.node);

    var heartsEl = document.getElementById('lessonHearts');
    heartsEl.innerHTML = lessonHeartsHTML(this.lives);

    var checkBtn = document.getElementById('lessonCheckBtn');
    checkBtn.textContent = screen.type === 'intro' ? 'START' : 'CHECK';
    checkBtn.className = 'lesson-check-btn';
    checkBtn.disabled = screen.type === 'intro' ? false : true;

    var content = document.getElementById('lessonContent');
    content.innerHTML = this.buildScreen(screen);
    content.scrollTop = 0;
    this.bindScreenInteractions(screen);
  },

  buildScreen: function(screen) {
    // The unit context now lives in the header bar, so screens no longer prepend a badge.
    var badge = '';
    if (screen.type === 'intro') {
      return '<div class="lesson-intro">' +
        '<div class="lesson-speech">' +
        '<div class="lesson-speech-accent">' + LESSON_CONCEPT_ICON + '</div>' +
        '<p class="lesson-speech-eyebrow">CONCEPT · ' + this.currentNode.title + '</p>' +
        '<p class="lesson-speech-text">' + screen.text + '</p>' +
        '</div>' +
        '<div class="lesson-intro-mascot" id="lessonInlineMascot"></div>' +
        '</div>';
    }
    if (screen.type === 'multiple_choice' || screen.type === 'fill_blank') {
      var opts = '';
      screen.options.forEach(function(opt, i) {
        opts += '<button class="lesson-option" data-idx="' + i + '">' + opt + '</button>';
      });
      var q = screen.type === 'fill_blank'
        ? screen.question.replace('[___]', '<span class="lesson-blank-slot">?</span>')
        : screen.question;
      return badge + '<p class="lesson-question">' + q + '</p><div class="lesson-options">' + opts + '</div><div id="lessonExplanation"></div>';
    }
    if (screen.type === 'true_false') {
      return badge + '<p class="lesson-question">' + screen.question + '</p>' +
        '<div class="lesson-tf-row">' +
        '<button class="lesson-tf-btn" data-val="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>True</button>' +
        '<button class="lesson-tf-btn" data-val="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>False</button>' +
        '</div><div id="lessonExplanation"></div>';
    }
    if (screen.type === 'matching') {
      var shuffledRights = screen.pairs.map(function(p, i) { return { text: p[1], idx: i }; })
        .sort(function() { return Math.random() - 0.5; });
      this.matchState = { pairIndex: 0, pairs: screen.pairs, shuffledRights: shuffledRights, allCorrect: true, done: false };
      return badge + '<p class="lesson-question">' + screen.question + '</p>' +
        '<div id="matchContainer">' + this._buildMatchPair(screen.pairs, shuffledRights, 0) + '</div>' +
        '<div id="lessonExplanation"></div>';
    }
    if (screen.type === 'drag_order') {
      var items = screen.items.slice().sort(function() { return Math.random() - 0.5; });
      this.dragOrder = items.slice();
      var rows = items.map(function(item) {
        return '<div class="lesson-drag-item" data-item="' + item + '" draggable="true">' +
          '<span class="drag-handle"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><rect y="4" width="24" height="2.5" rx="1.25"/><rect y="10.75" width="24" height="2.5" rx="1.25"/><rect y="17.5" width="24" height="2.5" rx="1.25"/></svg></span>' + item + '</div>';
      }).join('');
      return badge + '<p class="lesson-question">' + screen.question + '</p>' +
        '<div class="lesson-drag-list" id="dragList">' + rows + '</div><div id="lessonExplanation"></div>';
    }

    /* ── Type A: Sequence Builder ── */
    if (screen.type === 'sequence_builder') {
      var scrambled = screen.items.slice().sort(function() { return Math.random() - 0.5; });
      var chips = scrambled.map(function(item) {
        return '<button class="lesson-seq-chip" data-item="' + item + '">' + item + '</button>';
      }).join('');
      return badge + '<p class="lesson-question">' + screen.question + '</p>' +
        '<p class="lesson-seq-label">Your sequence</p>' +
        '<div class="lesson-seq-zone" id="seqZone"><span style="color:var(--text-muted);font-size:13px;font-style:italic;padding:4px">Tap cards below to build</span></div>' +
        '<p class="lesson-seq-label" style="margin-top:18px">Word bank</p>' +
        '<div class="lesson-seq-bank" id="seqBank">' + chips + '</div>' +
        '<div id="lessonExplanation"></div>';
    }

    /* ── Type B: Spot the Mistake ── */
    if (screen.type === 'spot_mistake') {
      var opts = screen.options.map(function(opt, i) {
        return '<button class="lesson-option" data-idx="' + i + '">' + opt + '</button>';
      }).join('');
      return badge +
        '<div class="lesson-scenario-card"><div class="lesson-scenario-label">\u{1F4CB} Scenario</div>' +
        '<p class="lesson-scenario-text">' + screen.scenario + '</p></div>' +
        '<p class="lesson-question">' + screen.question + '</p>' +
        '<div class="lesson-options">' + opts + '</div><div id="lessonExplanation"></div>';
    }

    /* ── Type C: Fill-in-the-Blank Multi ── */
    if (screen.type === 'fill_blank_multi') {
      var template = screen.template;
      screen.blanks.forEach(function(blank, i) {
        template = template.replace('[__' + (i + 1) + '__]',
          '<span class="lesson-blank-slot empty" data-blank="' + i + '">______</span>');
      });
      var allWords = [];
      screen.blanks.forEach(function(b) {
        b.options.forEach(function(w) { if (allWords.indexOf(w) === -1) allWords.push(w); });
      });
      allWords.sort(function() { return Math.random() - 0.5; });
      var chips2 = allWords.map(function(word) {
        return '<button class="lesson-wordbank-chip" data-word="' + word + '">' + word + '</button>';
      }).join('');
      return badge + '<p class="lesson-fill-sentence">' + template + '</p>' +
        '<div class="lesson-wordbank" id="wordBank">' + chips2 + '</div>' +
        '<div id="lessonExplanation"></div>';
    }

    /* ── Type D: Ingredient Matchmaker ── */
    if (screen.type === 'ingredient_match') {
      var opts2 = screen.options.map(function(opt, i) {
        return '<button class="lesson-option ingredient-opt" data-idx="' + i + '">' +
          '<span class="lesson-option-ing-name">' + opt.label + '</span>' +
          '<span class="lesson-option-ing-detail">' + opt.detail + '</span>' +
          '</button>';
      }).join('');
      return badge +
        '<div class="lesson-concern-card"><div class="lesson-concern-label">&#127919; Skin Concern</div>' +
        '<p class="lesson-concern-text">' + screen.concern + '</p></div>' +
        '<p class="lesson-question">' + screen.question + '</p>' +
        '<div class="lesson-options">' + opts2 + '</div><div id="lessonExplanation"></div>';
    }

    return '';
  },

  _buildMatchPair: function(pairs, shuffledRights, idx) {
    var progress = (idx + 1) + ' of ' + pairs.length;
    var opts = shuffledRights.map(function(r, i) {
      return '<button class="lesson-option match-right-opt" data-ridx="' + i + '" data-orig="' + r.idx + '">' + r.text + '</button>';
    }).join('');
    return '<div class="match-prompt-card" id="matchPromptCard">' +
      '<span class="match-progress" id="matchProgress">' + progress + '</span>' +
      '<p class="match-prompt-text" id="matchPromptText">' + pairs[idx][0] + '</p></div>' +
      '<div class="match-options">' + opts + '</div>';
  },

  bindScreenInteractions: function(screen) {
    var self = this;

    if (screen.type === 'intro') {
      var m = document.getElementById('lessonInlineMascot');
      var introPoses = ['happy', 'thinking', 'excited', 'sunny'];
      var pose = introPoses[(this.currentNode.node - 1) % introPoses.length];
      if (m && typeof mascot === 'function') m.innerHTML = mascot(pose, 'lesson' + this.currentScreen);
      return;
    }

    var checkBtn = document.getElementById('lessonCheckBtn');

    if (screen.type === 'multiple_choice' || screen.type === 'fill_blank') {
      document.querySelectorAll('.lesson-option').forEach(function(btn) {
        btn.addEventListener('click', function() {
          if (self.answered) return;
          document.querySelectorAll('.lesson-option').forEach(function(b) { b.classList.remove('selected'); });
          btn.classList.add('selected');
          self.selectedAnswer = parseInt(btn.dataset.idx);
          checkBtn.disabled = false;
          SFX.select();
          if (window.webkit && window.webkit.messageHandlers && window.webkit.messageHandlers.hapticSelection) {
            window.webkit.messageHandlers.hapticSelection.postMessage(null);
          }
        });
      });
    }

    if (screen.type === 'true_false') {
      document.querySelectorAll('.lesson-tf-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          if (self.answered) return;
          document.querySelectorAll('.lesson-tf-btn').forEach(function(b) { b.classList.remove('selected'); });
          btn.classList.add('selected');
          self.selectedAnswer = btn.dataset.val === 'true';
          checkBtn.disabled = false;
          SFX.select();
          if (window.webkit && window.webkit.messageHandlers && window.webkit.messageHandlers.hapticSelection) {
            window.webkit.messageHandlers.hapticSelection.postMessage(null);
          }
        });
      });
    }

    if (screen.type === 'matching') {
      if (checkBtn) checkBtn.style.display = 'none';
      var ms = self.matchState;
      function bindMatchOpts() {
        document.querySelectorAll('.match-right-opt').forEach(function(btn) {
          if (btn._matchBound) return;
          btn._matchBound = true;
          btn.addEventListener('click', function() {
            if (btn.disabled || btn.classList.contains('lesson-option--correct')) return;
            var isCorrect = parseInt(btn.dataset.orig) === ms.pairIndex;
            if (isCorrect) {
              SFX.correct();
              if (window.webkit && window.webkit.messageHandlers && window.webkit.messageHandlers.hapticSelection) {
                window.webkit.messageHandlers.hapticSelection.postMessage(null);
              }
              btn.classList.add('lesson-option--correct');
              btn.disabled = true;
              ms.pairIndex++;
              if (ms.pairIndex >= ms.pairs.length) {
                ms.done = true;
                self.answered = true;
                self.selectedAnswer = ms.allCorrect;
                if (checkBtn) {
                  checkBtn.style.display = '';
                  checkBtn.disabled = false;
                  checkBtn.textContent = 'NEXT →';
                  checkBtn.className = 'lesson-check-btn correct';
                }
                var card = document.getElementById('matchPromptCard');
                if (card) card.innerHTML =
                  '<div class="match-complete-icon"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#1E9E6B" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></div>' +
                  '<p class="match-complete-text">All matched!</p>';
              } else {
                var prog = document.getElementById('matchProgress');
                var txt  = document.getElementById('matchPromptText');
                if (prog) prog.textContent = (ms.pairIndex + 1) + ' of ' + ms.pairs.length;
                if (txt)  txt.textContent  = ms.pairs[ms.pairIndex][0];
              }
            } else {
              ms.allCorrect = false;
              btn.classList.add('lesson-option--incorrect');
              btn.disabled = true;
              setTimeout(function() {
                btn.classList.remove('lesson-option--incorrect');
                btn.disabled = false;
              }, 700);
            }
          });
        });
      }
      bindMatchOpts();
    }

    if (screen.type === 'drag_order') {
      var list = document.getElementById('dragList');
      var dragging = null;
      list.querySelectorAll('.lesson-drag-item').forEach(function(item) {
        item.addEventListener('dragstart', function() { dragging = item; item.classList.add('dragging'); });
        item.addEventListener('dragend', function() { item.classList.remove('dragging'); dragging = null; });
        item.addEventListener('dragover', function(e) {
          e.preventDefault();
          if (dragging && dragging !== item) {
            var rect = item.getBoundingClientRect();
            var mid = rect.top + rect.height / 2;
            if (e.clientY < mid) { list.insertBefore(dragging, item); }
            else { list.insertBefore(dragging, item.nextSibling); }
          }
        });
        item.addEventListener('touchstart', function(e) {
          dragging = item;
          item.classList.add('dragging');
          var touch = e.touches[0];
          var clone = item.cloneNode(true);
          clone.id = 'dragClone';
          clone.style.cssText = 'position:fixed;z-index:9999;pointer-events:none;transform:scale(1.06) rotate(-1deg);transition:none;left:' + (touch.clientX - item.offsetWidth/2) + 'px;top:' + (touch.clientY - item.offsetHeight/2) + 'px;width:' + item.offsetWidth + 'px;margin:0;background:#1e2540;border:2px solid rgba(56,189,248,0.6);border-radius:14px;color:#fff;';
          document.body.appendChild(clone);
        }, {passive:true});
        item.addEventListener('touchend', function() {
          item.classList.remove('dragging');
          dragging = null;
          var clone = document.getElementById('dragClone');
          if (clone) clone.remove();
          checkBtn.disabled = false;
        });
        item.addEventListener('touchmove', function(e) {
          e.preventDefault();
          var touch = e.touches[0];
          var clone = document.getElementById('dragClone');
          if (clone) {
            clone.style.left = (touch.clientX - item.offsetWidth/2) + 'px';
            clone.style.top = (touch.clientY - item.offsetHeight/2) + 'px';
          }
          var target = document.elementFromPoint(touch.clientX, touch.clientY);
          if (target && target.classList.contains('lesson-drag-item') && target !== item) {
            list.insertBefore(item, target);
          }
        }, {passive:false});
      });
      list.addEventListener('dragover', function(e) { e.preventDefault(); });
      checkBtn.disabled = false;
    }

    /* ── Type A: Sequence Builder ── */
    if (screen.type === 'sequence_builder') {
      var zone = document.getElementById('seqZone');
      var bank = document.getElementById('seqBank');
      function updateSeqBtn() {
        var filled = zone.querySelectorAll('.lesson-seq-chip').length;
        checkBtn.disabled = (filled < screen.items.length);
        zone.classList.toggle('has-items', filled > 0);
      }
      bank.addEventListener('click', function(e) {
        var chip = e.target.closest('.lesson-seq-chip');
        if (!chip || self.answered) return;
        var hint = zone.querySelector('span');
        if (hint) hint.remove();
        chip.classList.add('in-zone');
        zone.appendChild(chip);
        SFX.select();
        updateSeqBtn();
      });
      zone.addEventListener('click', function(e) {
        var chip = e.target.closest('.lesson-seq-chip');
        if (!chip || self.answered) return;
        chip.classList.remove('in-zone');
        bank.appendChild(chip);
        SFX.select();
        updateSeqBtn();
      });
    }

    /* ── Type B + Type D: MC-style selection ── */
    if (screen.type === 'spot_mistake' || screen.type === 'ingredient_match') {
      document.querySelectorAll('.lesson-option').forEach(function(btn) {
        btn.addEventListener('click', function() {
          if (self.answered) return;
          document.querySelectorAll('.lesson-option').forEach(function(b) { b.classList.remove('selected'); });
          btn.classList.add('selected');
          self.selectedAnswer = parseInt(btn.dataset.idx);
          checkBtn.disabled = false;
          SFX.select();
          if (window.webkit && window.webkit.messageHandlers && window.webkit.messageHandlers.hapticSelection) {
            window.webkit.messageHandlers.hapticSelection.postMessage(null);
          }
        });
      });
    }

    /* ── Type C: Multi-blank fill ── */
    if (screen.type === 'fill_blank_multi') {
      self.blankAnswers = new Array(screen.blanks.length).fill(null);
      function firstEmpty() {
        for (var ii = 0; ii < self.blankAnswers.length; ii++) { if (self.blankAnswers[ii] === null) return ii; }
        return -1;
      }
      function updateFillBtn() {
        checkBtn.disabled = self.blankAnswers.some(function(a) { return a === null; });
      }
      document.getElementById('wordBank').addEventListener('click', function(e) {
        var chip = e.target.closest('.lesson-wordbank-chip');
        if (!chip || chip.classList.contains('used') || self.answered) return;
        var idx = firstEmpty();
        if (idx === -1) return;
        self.blankAnswers[idx] = chip.dataset.word;
        chip.classList.add('used');
        var slot = document.querySelector('.lesson-blank-slot[data-blank="' + idx + '"]');
        if (slot) { slot.textContent = chip.dataset.word; slot.classList.remove('empty'); slot.classList.add('filled'); }
        SFX.select();
        updateFillBtn();
      });
      document.querySelectorAll('.lesson-blank-slot').forEach(function(slot) {
        slot.addEventListener('click', function() {
          if (self.answered || slot.classList.contains('empty')) return;
          var idx = parseInt(slot.dataset.blank);
          var word = self.blankAnswers[idx];
          self.blankAnswers[idx] = null;
          slot.textContent = '______'; slot.classList.add('empty'); slot.classList.remove('filled');
          var chip = document.querySelector('.lesson-wordbank-chip[data-word="' + word + '"]');
          if (chip) chip.classList.remove('used');
          SFX.select();
          updateFillBtn();
        });
      });
    }
  },

  check: function() {
    var screen = this.currentNode.screens[this.currentScreen];
    var checkBtn = document.getElementById('lessonCheckBtn');

    if (this.answered || screen.type === 'intro' || screen.type === 'matching') {
      this.advance();
      return;
    }

    this.answered = true;
    var isCorrect = false;
    var smartWrongExp = null; // per-wrong-answer explanation

    if (screen.type === 'multiple_choice' || screen.type === 'fill_blank') {
      isCorrect = this.selectedAnswer === screen.correct;
      if (!isCorrect && screen.wrong_explanations && screen.wrong_explanations[this.selectedAnswer]) {
        smartWrongExp = screen.wrong_explanations[this.selectedAnswer];
      }
      document.querySelectorAll('.lesson-option').forEach(function(btn, i) {
        if (i === screen.correct) btn.classList.add('correct');
        else if (btn.classList.contains('selected')) btn.classList.add('incorrect');
      });
    }

    if (screen.type === 'true_false') {
      isCorrect = this.selectedAnswer === screen.correct;
      document.querySelectorAll('.lesson-tf-btn').forEach(function(btn) {
        var val = btn.dataset.val === 'true';
        if (val === screen.correct) btn.classList.add('correct');
        else if (btn.classList.contains('selected')) btn.classList.add('incorrect');
      });
    }

    if (screen.type === 'drag_order') {
      var list = document.getElementById('dragList');
      var items = list.querySelectorAll('.lesson-drag-item');
      var order = [];
      items.forEach(function(i) { order.push(i.dataset.item); });
      isCorrect = JSON.stringify(order) === JSON.stringify(screen.correct_order);
      items.forEach(function(item, i) {
        item.classList.add(item.dataset.item === screen.correct_order[i] ? 'correct' : 'incorrect');
      });
    }

    /* ── Type A: Sequence Builder check ── */
    if (screen.type === 'sequence_builder') {
      var zone = document.getElementById('seqZone');
      var zoneChips = zone.querySelectorAll('.lesson-seq-chip');
      var zoneOrder = [];
      zoneChips.forEach(function(c) { zoneOrder.push(c.dataset.item); });
      isCorrect = JSON.stringify(zoneOrder) === JSON.stringify(screen.correct_order);
      zoneChips.forEach(function(c, i) {
        c.classList.add(c.dataset.item === screen.correct_order[i] ? 'correct' : 'incorrect');
      });
    }

    /* ── Type B: Spot the Mistake check ── */
    if (screen.type === 'spot_mistake') {
      isCorrect = this.selectedAnswer === screen.correct;
      if (!isCorrect && screen.wrong_explanations && screen.wrong_explanations[this.selectedAnswer]) {
        smartWrongExp = screen.wrong_explanations[this.selectedAnswer];
      }
      document.querySelectorAll('.lesson-option').forEach(function(btn, i) {
        if (i === screen.correct) btn.classList.add('correct');
        else if (btn.classList.contains('selected')) btn.classList.add('incorrect');
      });
    }

    /* ── Type C: Fill-in-the-Blank Multi check ── */
    if (screen.type === 'fill_blank_multi') {
      var allRight = true;
      var blankAnss = this.blankAnswers || [];
      screen.blanks.forEach(function(blank, i) {
        var correctWord = blank.options[blank.correct];
        var userWord = blankAnss[i];
        if (userWord !== correctWord) allRight = false;
        var slot = document.querySelector('.lesson-blank-slot[data-blank="' + i + '"]');
        if (slot) slot.classList.add(userWord === correctWord ? 'correct' : 'incorrect');
      });
      isCorrect = allRight;
    }

    /* ── Type D: Ingredient Matchmaker check ── */
    if (screen.type === 'ingredient_match') {
      var correctIdx = -1;
      for (var ci = 0; ci < screen.options.length; ci++) {
        if (screen.options[ci].correct) { correctIdx = ci; break; }
      }
      isCorrect = this.selectedAnswer === correctIdx;
      if (!isCorrect && screen.options[this.selectedAnswer] && screen.options[this.selectedAnswer].wrong_explanation) {
        smartWrongExp = screen.options[this.selectedAnswer].wrong_explanation;
      }
      document.querySelectorAll('.lesson-option').forEach(function(btn, i) {
        if (i === correctIdx) btn.classList.add('correct');
        else if (btn.classList.contains('selected')) btn.classList.add('incorrect');
      });
    }

    if (!isCorrect) { this.lives = Math.max(0, this.lives - 1); }
    if (isCorrect) { SFX.correct(); } else { SFX.wrong(); }

    var explEl = document.getElementById('lessonExplanation');
    var explText = (!isCorrect && smartWrongExp) ? smartWrongExp : screen.explanation;
    if (explEl && explText) {
      var pose = isCorrect ? (['excited','celebrate','love','proud'][Math.floor(Math.random()*4)])
                           : (['sad','surprised','thinking'][Math.floor(Math.random()*3)]);
      var lead = isCorrect ? '<b>Correct!</b> ' : '<b>Not quite!</b> ';
      explEl.className = '';
      explEl.innerHTML = '<div class="lesson-feedback">' +
        '<div class="lesson-feedback-mascot">' + mascot(pose, 'fb' + Date.now()) + '</div>' +
        '<div class="lesson-feedback-bubble ' + (isCorrect ? 'correct' : 'incorrect') + '">' + lead + explText + '</div>' +
      '</div>';
    }

    checkBtn.textContent = 'CONTINUE';
    checkBtn.className = 'lesson-check-btn ' + (isCorrect ? 'correct' : 'incorrect');
    checkBtn.disabled = false;

    var heartsEl = document.getElementById('lessonHearts');
    heartsEl.innerHTML = lessonHeartsHTML(this.lives);
  },

  advance: function() {
    this.currentScreen++;
    if (this.currentScreen >= this.currentNode.screens.length) {
      this.complete();
      return;
    }
    this.renderScreen();
  },

  complete: function() {
    this.clearInProgress();
    var nodeNum = this.currentNode.node;
    var p = this.getProgress();
    var isNew = p.completed.indexOf(nodeNum) === -1;
    if (!isNew) {
      p.xp = (p.xp || 0) + 25;
      this.saveProgress(p);
    }
    if (isNew) {
      p.completed.push(nodeNum);
      p.xp = (p.xp || 0) + 100;

      // Lesson streak: track consecutive days with at least one lesson
      var todayStr = (function() {
        var d = new Date();
        return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
      })();
      var yesterday = (function() {
        var d = new Date(); d.setDate(d.getDate()-1);
        return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
      })();
      var streakIncremented = false;
      if (p.lastLessonDate === todayStr) {
        // already counted today, streak unchanged
      } else if (p.lastLessonDate === yesterday) {
        p.lessonStreak = (p.lessonStreak || 0) + 1;
        streakIncremented = true;
      } else {
        p.lessonStreak = 1; // broken or first day
        streakIncremented = true;
      }
      p.lastLessonDate = todayStr;
      this.saveProgress(p);
    }

    if (typeof MetricsBar !== 'undefined') {
      MetricsBar.update('xp', p.xp);
      MetricsBar.update('streak', p.lessonStreak || 0);
    } else {
      var xv = document.getElementById('learnXpVal'); if (xv) xv.textContent = p.xp;
      var sv = document.getElementById('learnStreakVal'); if (sv) sv.textContent = p.lessonStreak || 0;
    }

    // Update Daily Quests (Deep Learner)
    if (typeof DailyQuests !== 'undefined') DailyQuests.render();

    var streakPill = (typeof streakIncremented !== 'undefined' && streakIncremented)
      ? '<span class="lesson-reward-pill streak"><svg width="14" height="14" viewBox="0 0 24 24" fill="#FF9500" style="vertical-align:middle;margin-right:4px"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>Streak Saved!</span>'
      : '';

    var isUnitComplete = [5,10,15,20,25,30,35,40,45].indexOf(nodeNum) !== -1;
    if (isUnitComplete) { SFX.unitReward(); } else { SFX.reward(); }
    var featurePromo = this.currentNode.feature_promo || '';
    var content = document.getElementById('lessonContent');
    content.innerHTML = '<div class="lesson-reward">' +
      '<div class="lesson-reward-mascot">' + mascot('celebrate', 'reward' + Date.now()) + '</div>' +
      '<p class="lesson-reward-title">Lesson Complete!</p>' +
      '<p class="lesson-reward-sub">' + (this.currentNode.celebration || (this.currentNode.title + ' mastered')) + '</p>' +
      '<div class="lesson-reward-pills">' +
      (isNew ? '<span class="lesson-reward-pill xp">+100 Glow XP</span>' : '<span class="lesson-reward-pill xp">+25 Glow XP</span>') +
      streakPill +
      (isUnitComplete ? '<span class="lesson-reward-pill unlock">🔓 ' + lessonUnitFocus(nodeNum).split(' · ')[0] + ' Complete!</span>' : '') +
      '</div>' +
      (featurePromo ? '<div class="lesson-feature-promo">' + featurePromo + '</div>' : '') +
      '</div>';

    var checkBtn = document.getElementById('lessonCheckBtn');
    checkBtn.textContent = isUnitComplete ? 'CLAIM REWARDS' : 'CONTINUE';
    checkBtn.className = 'lesson-check-btn correct';
    checkBtn.disabled = false;
    this.answered = true;
    this.isComplete = true;

    // Track lesson completion date for calendar
    var today = (function() {
      var d = new Date();
      return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
    })();
    var lessonDates = JSON.parse(localStorage.getItem('glowo_lesson_dates') || '[]');
    if (lessonDates.indexOf(today) === -1) lessonDates.push(today);
    localStorage.setItem('glowo_lesson_dates', JSON.stringify(lessonDates));

    document.getElementById('lessonProgressFill').style.width = '100%';
  }
};

function updateLearnPathNodes() {
  var completed = LessonEngine.getProgress().completed;
  var totalNodes = 45;

  // Clear all mascots and START labels
  document.querySelectorAll('.learn-mascot-beside').forEach(function(m) {
    m.style.display = 'none';
    m.innerHTML = '';
  });
  document.querySelectorAll('.learn-node-start-label').forEach(function(l) { l.remove(); });

  // Progress is strictly sequential. Compute the "unlock frontier" — how many
  // nodes are completed in an unbroken run starting from node 1. Only this
  // contiguous run counts, so a stray or out-of-order completion (a gap in the
  // array) can never unlock a node in a later section.
  var frontier = 0;
  while (completed.indexOf(frontier + 1) > -1) frontier++;
  var activeNodeNum = (frontier < totalNodes) ? frontier + 1 : null;

  for (var n = 1; n <= totalNodes; n++) {
    var el = document.querySelector('.learn-node[data-lesson="' + n + '"]');
    if (!el) continue;
    el.classList.remove('learn-node--done', 'learn-node--active', 'learn-node--locked');
    if (n <= frontier) {
      el.classList.add('learn-node--done');
    } else if (n === activeNodeNum) {
      el.classList.add('learn-node--active');
    } else {
      el.classList.add('learn-node--locked');
    }
  }

  // Show mascot + START label next to the first active node
  if (activeNodeNum !== null) {
    var mascotEl = document.getElementById('learnMascot-' + activeNodeNum);
    if (mascotEl && typeof mascot === 'function') {
      mascotEl.innerHTML = mascot('happy', 'path' + activeNodeNum);
      mascotEl.style.display = '';
    }
    // Inject START bubble above active node
    var activeEl = document.querySelector('.learn-node[data-lesson="' + activeNodeNum + '"]');
    if (activeEl) {
      var lbl = document.createElement('div');
      lbl.className = 'learn-node-start-label';
      lbl.textContent = 'START';
      activeEl.appendChild(lbl);
    }
  }
}

// Floating banner scroll listener
var UNIT_BANNER_DATA = [
    { id: 'unitSectionWelcome', eyebrow: 'SECTION 1', title: "Welcome! Let's See What You Know!", bg: '#38bdf8',                                          slab: '#0369a1', btn: '#38bdf8' },
    { id: 'unitSection1', eyebrow: 'SECTION 2', title: 'Skincare Basics: Know Your Skin',    bg: '#14B8A6', slab: '#0c5d52', btn: '#14B8A6' },
    { id: 'unitSection2', eyebrow: 'SECTION 3', title: 'Active Ingredients',                 bg: '#7C3AED', slab: '#2e0f6e', btn: '#7C3AED' },
    { id: 'unitSection3', eyebrow: 'SECTION 4', title: 'Managing Skin Conditions',           bg: '#10B981', slab: '#024d37', btn: '#10B981' },
    { id: 'unitSection4', eyebrow: 'SECTION 5', title: 'Advanced Skincare Habits',           bg: '#F59E0B', slab: '#703b08', btn: '#F59E0B' },
    { id: 'unitSection5', eyebrow: 'SECTION 6', title: 'Weather, Climate & Seasons',         bg: '#0891b2', slab: '#0a2e4a', btn: '#0891b2' },
    { id: 'unitSection6', eyebrow: 'SECTION 7', title: 'Deciphering the Product Label',      bg: '#4f46e5', slab: '#231e7a', btn: '#4f46e5' },
    { id: 'unitSection7', eyebrow: 'SECTION 8', title: 'The Science of Elasticity',          bg: '#db2777', slab: '#6b0b30', btn: '#db2777' },
    { id: 'unitSection8', eyebrow: 'SECTION 9', title: 'The Skin-Body Connection',           bg: '#ea580c', slab: '#7c2206', btn: '#ea580c' }
  ];
(function() {
  function updateFloatBanner() {
    var scroller = document.getElementById('screen-progress');
    var banner = document.getElementById('floatBanner');
    var eyebrow = document.getElementById('floatBannerEyebrow');
    var title = document.getElementById('floatBannerTitle');
    if (!scroller || !banner) return;

    var scrollerRect = scroller.getBoundingClientRect();
    var bannerBottom = banner.getBoundingClientRect().bottom;
    var active = UNIT_BANNER_DATA[0];
    for (var i = 0; i < UNIT_BANNER_DATA.length; i++) {
      var sec = document.getElementById(UNIT_BANNER_DATA[i].id);
      if (!sec) continue;
      var rect = sec.getBoundingClientRect();
      // Switch when the last node of this unit passes the bottom edge of the floating banner
      if (rect.bottom > bannerBottom) {
        active = UNIT_BANNER_DATA[i];
        break;
      }
    }
    if (active.id !== updateFloatBanner._lastId) {
      updateFloatBanner._lastId = active.id;
      if (window.webkit && window.webkit.messageHandlers && window.webkit.messageHandlers.haptic) {
        window.webkit.messageHandlers.haptic.postMessage('light');
      }
    }
    banner.style.background = active.bg;
    banner.style.boxShadow = '0 4px 0 0 ' + active.slab + ', inset 0 1px 0 rgba(255,255,255,0.22)';
    if (eyebrow) eyebrow.textContent = active.eyebrow;
    if (title) title.textContent = active.title;
  }

  document.addEventListener('DOMContentLoaded', function() {
    var scroller = document.getElementById('screen-progress');
    if (scroller) {
      scroller.addEventListener('scroll', updateFloatBanner, { passive: true });
    }
  });
  // Also expose for calling after navigate
  window._updateFloatBanner = updateFloatBanner;
})();

// Wire legal screen back buttons
document.addEventListener('DOMContentLoaded', function() {
  var privacyBack = document.getElementById('privacyBackBtn');
  if (privacyBack) privacyBack.addEventListener('click', function() {
    document.getElementById('screen-privacy').classList.remove('open');
  });
  var termsBack = document.getElementById('termsBackBtn');
  if (termsBack) termsBack.addEventListener('click', function() {
    document.getElementById('screen-terms').classList.remove('open');
  });
});

// Wire up lesson overlay buttons + node clicks after DOM is ready
document.addEventListener('DOMContentLoaded', function() {
  // Init daily quests on first load
  if (typeof DailyQuests !== 'undefined') DailyQuests.render();
  var closeBtn = document.getElementById('lessonCloseBtn');
  var checkBtn = document.getElementById('lessonCheckBtn');
  var exitBackdrop = document.getElementById('exitDialogBackdrop');
  var exitCancel = document.getElementById('exitDialogCancel');
  var exitConfirm = document.getElementById('exitDialogConfirm');

  function showExitDialog() {
    var p = LessonEngine.getProgress();
    LessonEngine.saveProgress(p);
    exitBackdrop.classList.add('active');
  }
  function hideExitDialog() {
    exitBackdrop.classList.remove('active');
  }
  if (exitCancel) exitCancel.addEventListener('click', hideExitDialog);
  if (exitBackdrop) exitBackdrop.addEventListener('click', function(e) {
    if (e.target === exitBackdrop) hideExitDialog();
  });
  if (exitConfirm) exitConfirm.addEventListener('click', function() {
    LessonEngine.saveInProgress();
    hideExitDialog();
    LessonEngine.close();
  });

  if (closeBtn) closeBtn.addEventListener('click', function() {
    if (LessonEngine.isComplete) { LessonEngine.close(); return; }
    showExitDialog();
  });
  if (checkBtn) checkBtn.addEventListener('click', function() {
    if (window.webkit && window.webkit.messageHandlers && window.webkit.messageHandlers.hapticSelection) {
      window.webkit.messageHandlers.hapticSelection.postMessage(null);
    }
    if (LessonEngine.isComplete) { LessonEngine.close(); return; }
    var screen = LessonEngine.currentNode && LessonEngine.currentNode.screens[LessonEngine.currentScreen];
    if (LessonEngine.answered || (screen && screen.type === 'intro')) {
      SFX.advance();
      LessonEngine.advance();
    } else {
      LessonEngine.check();
    }
  });

  var activeTooltipNode = null;
  var activeTooltipNodeEl = null;

  function positionTooltip(tt, nodeEl) {
    var wrap = document.getElementById('learnPathWrap');
    if (!wrap) return;
    // Reparent into the scrolling content so the tooltip moves natively with scroll
    if (tt.parentElement !== wrap) wrap.appendChild(tt);
    var nodeRect = nodeEl.getBoundingClientRect();
    var wrapRect = wrap.getBoundingClientRect();
    var ttW = 240;
    // Position relative to learn-path-wrap (stable across scroll)
    var centerX = (nodeRect.left - wrapRect.left) + nodeRect.width / 2;
    var left = centerX - ttW / 2;
    left = Math.max(12, Math.min(left, wrap.clientWidth - ttW - 12));
    var top = (nodeRect.bottom - wrapRect.top) + 16;
    tt.style.left = left + 'px';
    tt.style.top = top + 'px';
    tt.style.width = ttW + 'px';
  }

  function hideLessonTooltip() {
    var tt = document.getElementById('lessonTooltip');
    if (tt) tt.style.display = 'none';
    activeTooltipNode = null;
    activeTooltipNodeEl = null;
  }

  function showLessonTooltip(lessonNum, nodeEl) {
    var nodeData = ALL_LESSONS_DATA.filter(function(d) { return d.node === lessonNum; })[0];
    var title = nodeData ? nodeData.title : 'Lesson ' + lessonNum;
    var isDone = LessonEngine.getProgress().completed.indexOf(lessonNum) > -1;
    var savedIP = null;
    try { savedIP = JSON.parse(localStorage.getItem('glowo_lesson_inprogress')); } catch(e) {}
    var hasInProgress = savedIP && savedIP.node === lessonNum && savedIP.screen > 0;
    var btnLabel = hasInProgress ? 'CONTINUE' : (isDone ? 'REPLAY +25 XP' : 'START +100 XP');

    // Resolve unit color by walking up to the parent unit section
    var unitColor = 'var(--blue-primary)';
    var unitShadow = '#0369a1';
    var ancestor = nodeEl.parentElement;
    while (ancestor && ancestor !== document.body) {
      for (var u = 0; u < UNIT_BANNER_DATA.length; u++) {
        if (ancestor.id === UNIT_BANNER_DATA[u].id) {
          unitColor = UNIT_BANNER_DATA[u].btn;
          unitShadow = UNIT_BANNER_DATA[u].slab;
          break;
        }
      }
      if (unitColor !== 'var(--blue-primary)') break;
      ancestor = ancestor.parentElement;
    }

    var tt = document.getElementById('lessonTooltip');
    // Ensure tooltip lives inside the scrolling content before animating (so it scrolls natively)
    var wrap = document.getElementById('learnPathWrap');
    if (wrap && tt.parentElement !== wrap) wrap.appendChild(tt);
    tt.innerHTML = '<p class="lesson-tooltip-title">' + title + '</p>' +
      '<button class="lesson-tooltip-start" id="lessonTooltipStart" style="background:' + unitColor + ';box-shadow:0 4px 0 ' + unitShadow + ';">' + btnLabel + '</button>';
    // Force animation replay even if tooltip was already visible
    tt.style.animation = 'none';
    tt.style.display = 'block';
    tt.offsetHeight; // trigger reflow
    tt.style.animation = '';

    tt.classList.remove('flipped');
    activeTooltipNode = lessonNum;
    activeTooltipNodeEl = nodeEl;
    positionTooltip(tt, nodeEl);
    document.getElementById('lessonTooltipStart').addEventListener('click', function() {
      if (window.webkit && window.webkit.messageHandlers && window.webkit.messageHandlers.hapticSelection) {
        window.webkit.messageHandlers.hapticSelection.postMessage(null);
      }
      hideLessonTooltip();
      LessonEngine.open(lessonNum);
    });
  }

  // Dismiss tooltip when tapping outside
  document.addEventListener('click', function(e) {
    if (activeTooltipNode === null) return;
    var tt = document.getElementById('lessonTooltip');
    if (tt && !tt.contains(e.target) && !e.target.closest('.learn-node')) {
      hideLessonTooltip();
    }
  });

  // Tooltip lives inside the scrolling content, so it moves natively with scroll —
  // no JS repositioning needed. It renders under the sticky header and bottom nav.

  /* ═══════════════════════════════════════════════════════════════
     METRICS BAR — reward pop + XP progress bar
     All animations are transform/opacity only → compositor thread,
     zero layout reflow, zero input blocking.
     ═══════════════════════════════════════════════════════════════ */
  var MetricsBar = (function() {
    // XP wraps every 200 pts (25 XP × 8 lessons ≈ one visual cycle)
    var XP_LEVEL = 200;

    // Tracked previous values so we know when a counter actually rose
    var prev = { streak: 0, xp: 0, hearts: 5, energy: 25 };

    // Map stat key → DOM IDs
    var STAT = {
      streak: { badge: 'learnStatStreak', val: 'learnStreakVal' },
      xp:     { badge: 'learnStatXp',     val: 'learnXpVal'    },
      hearts: { badge: 'learnStatHearts', val: 'learnHeartsVal'},
      energy: { badge: 'learnStatEnergy', val: 'learnEnergyVal'},
    };

    function popBadge(key) {
      var badgeEl = document.getElementById(STAT[key].badge);
      if (!badgeEl) return;
      // Force animation restart via reflow trick (no setTimeout needed)
      badgeEl.classList.remove('stat-reward-pop');
      void badgeEl.offsetWidth;
      badgeEl.classList.add('stat-reward-pop');
      badgeEl.addEventListener('animationend', function onEnd() {
        badgeEl.classList.remove('stat-reward-pop');
        badgeEl.removeEventListener('animationend', onEnd);
      });
    }

    function setXpBar(xp) {
      var fill = document.getElementById('dashXpBarFill');
      if (!fill) return;
      var scale = (xp % XP_LEVEL) / XP_LEVEL;
      var level = Math.floor(xp / XP_LEVEL) + 1;
      var lvlEl = document.getElementById('dashLevelNum');
      var xpEl  = document.getElementById('dashXpVal');
      if (lvlEl) lvlEl.textContent = level;
      if (xpEl)  xpEl.textContent  = xp % XP_LEVEL;
      // Double-rAF forces transition to fire even if fill was just inserted
      requestAnimationFrame(function() {
        requestAnimationFrame(function() {
          fill.style.transform = 'scaleX(' + scale + ')';
        });
      });
    }

    function update(key, newVal) {
      newVal = +newVal || 0;
      var ids = STAT[key];
      if (!ids) return;
      var valEl = document.getElementById(ids.val);
      if (valEl) valEl.textContent = newVal;
      var increased = newVal > prev[key];
      prev[key] = newVal;
      if (increased) popBadge(key);
      if (key === 'xp' || key === 'energy') setXpBar(newVal);
    }

    // Initialise bar to current XP on page load
    function init() {
      var p = (typeof LessonEngine !== 'undefined') ? LessonEngine.getProgress() : null;
      if (p) {
        prev.xp = p.xp || 0;
        prev.streak = p.lessonStreak || 0;
        setXpBar(prev.xp);
      }
    }

    return { update: update, init: init, setXpBar: setXpBar };
  })();

  // Initialise after engine is ready
  MetricsBar.init();

  /* ═══════════════════════════════════════════════════════════════
     BUTTON SPRING PHYSICS
     Uses event delegation so dynamically-rendered buttons (lesson
     options, tf-buttons, match items) are covered automatically.
     Press-in:  55ms ease-in  → snappy, instant-feeling
     Press-out: 380ms spring  → cubic-bezier overshoot bounce-back
     ═══════════════════════════════════════════════════════════════ */
  var ButtonPhysics = (function() {
    var PRESS_TRANS   = 'transform 55ms cubic-bezier(0.4,0,1,1), box-shadow 55ms cubic-bezier(0.4,0,1,1)';
    var RELEASE_TRANS = 'transform 380ms cubic-bezier(0.34,1.56,0.64,1), box-shadow 200ms ease-out';

    var SELECTOR =
      '.btn-primary, .lesson-tooltip-start, .lesson-check-btn, ' +
      '.lesson-option, .lesson-tf-btn, ' +
      '.lesson-match-item:not(.matched-correct):not(.matched-incorrect), ' +
      '#btnCreateAccount, .splash-cta-btn, ' +
      '.exit-dialog-btn-cancel, .exit-dialog-btn-exit, ' +
      '.icon-btn, .legal-back-btn, ' +
      '.prof-badges-pager-btn:not(:disabled), .prof-badges-toggle, ' +
      '.scan-pack-option, .prog-tl-row';

    var activeEl = null;

    function closest(el, sel) {
      return el && el.closest ? el.closest(sel) : null;
    }

    function pressDown(el) {
      if (el.disabled) return;
      activeEl = el;
      el.style.transition = PRESS_TRANS;
      el.classList.add('btn-phys-pressing');
    }

    function pressUp() {
      if (!activeEl) return;
      var el = activeEl;
      activeEl = null;
      el.style.transition = RELEASE_TRANS;
      el.classList.remove('btn-phys-pressing');
    }

    document.addEventListener('mousedown', function(e) {
      var el = closest(e.target, SELECTOR);
      if (el) pressDown(el);
    });

    document.addEventListener('touchstart', function(e) {
      var el = closest(e.target, SELECTOR);
      if (el) pressDown(el);
    }, {passive: true});

    document.addEventListener('mouseup',    pressUp);
    document.addEventListener('touchend',   pressUp, {passive: true});
    document.addEventListener('touchcancel',pressUp, {passive: true});
    /* Release if pointer drags off the element */
    document.addEventListener('mouseleave', function(e) {
      if (activeEl && !activeEl.contains(e.relatedTarget)) pressUp();
    });

    return { PRESS_TRANS: PRESS_TRANS, RELEASE_TRANS: RELEASE_TRANS };
  })();

  // ── SFX Module — synthesised sounds, no files needed ──────────────────────

  document.querySelectorAll('.learn-node[data-lesson]').forEach(function(node) {
    // 3D press-down via JS (iOS :active is unreliable in WKWebView)
    // Spring physics: fast press-in, springy release via ButtonPhysics timing
    node.addEventListener('touchstart', function() {
      SFX.nodeTap();
      node.style.transition = ButtonPhysics.PRESS_TRANS;
      node.classList.add('is-pressed');
    }, {passive: true});
    node.addEventListener('touchend', function() {
      node.style.transition = ButtonPhysics.RELEASE_TRANS;
      node.classList.remove('is-pressed');
    }, {passive: true});
    node.addEventListener('touchcancel', function() {
      node.style.transition = ButtonPhysics.RELEASE_TRANS;
      node.classList.remove('is-pressed');
    }, {passive: true});

    node.addEventListener('click', function() {
      if (!node.classList.contains('learn-node--locked')) {
        if (window.webkit && window.webkit.messageHandlers && window.webkit.messageHandlers.hapticMedium) {
          window.webkit.messageHandlers.hapticMedium.postMessage(null);
        }
      }
      var lessonNum = parseInt(node.dataset.lesson);
      if (lessonNum > 45) return;
      if (node.classList.contains('learn-node--locked')) return;
      if (activeTooltipNode === lessonNum) {
        hideLessonTooltip();
        return;
      }
      // Hide without animation, then show with fresh animation
      hideLessonTooltip();
      showLessonTooltip(lessonNum, node);
    });
  });

  // Expose a helper so the navigation code can pre-open lesson 1's "Start" tooltip
  // whenever the user lands on the Path, so it's obvious where to begin.
  window._openFirstLessonTooltip = function() {
    var firstNode = document.querySelector('.learn-node[data-lesson="1"]');
    if (!firstNode || firstNode.classList.contains('learn-node--locked')) return;
    // Only auto-open while lesson 1 hasn't been completed yet.
    if (firstNode.classList.contains('learn-node--done')) return;
    if (activeTooltipNode === 1) return;
    showLessonTooltip(1, firstNode);
  };

  // ── Snake path trail ──────────────────────────────────────────────
  function drawSnakeTrail() {
    var old = document.getElementById('snakeTrailSvg');
    if (old) old.remove();

    var wrap = document.getElementById('learnPathWrap');
    if (!wrap) return;
    var nodes = Array.from(wrap.querySelectorAll('.learn-node[data-lesson]'));
    if (nodes.length < 2) return;

    var wrapRect = wrap.getBoundingClientRect();
    var pts = nodes.map(function(n) {
      var r = n.getBoundingClientRect();
      return { x: r.left - wrapRect.left + r.width / 2,
               y: r.top  - wrapRect.top  + r.height / 2 };
    });

    var isDark = document.body.classList.contains('dark-mode');
    var trailColor = isDark ? 'rgba(255,255,255,0.13)' : 'rgba(0,0,0,0.10)';

    var d = 'M' + pts[0].x + ',' + pts[0].y;
    for (var i = 1; i < pts.length; i++) {
      var p = pts[i - 1], q = pts[i];
      var midY = (p.y + q.y) / 2;
      d += ' C' + p.x + ',' + midY + ' ' + q.x + ',' + midY + ' ' + q.x + ',' + q.y;
    }

    var svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
    svg.id = 'snakeTrailSvg';
    svg.setAttribute('aria-hidden', 'true');
    svg.style.cssText = 'position:absolute;top:0;left:0;width:100%;height:' + wrap.scrollHeight + 'px;pointer-events:none;z-index:0;overflow:visible;';

    var path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    path.setAttribute('d', d);
    path.setAttribute('fill', 'none');
    path.setAttribute('stroke', trailColor);
    path.setAttribute('stroke-width', '14');
    path.setAttribute('stroke-dasharray', '4,20');
    path.setAttribute('stroke-linecap', 'round');

    svg.appendChild(path);
    wrap.insertBefore(svg, wrap.firstChild);
  }

  // Draw trail after layout settles, and re-draw on dark-mode toggle
  setTimeout(drawSnakeTrail, 120);
  window._drawSnakeTrail = drawSnakeTrail;
});

} catch(e) {
  function showErr() {
    var d = document.createElement('div');
    d.style.cssText = 'position:fixed;inset:0;background:rgba(200,0,0,0.97);color:#fff;padding:30px;z-index:999999;font-family:monospace;font-size:13px;white-space:pre-wrap;overflow:auto;';
    d.innerHTML = '<h2>JS Error</h2><b>' + e.message + '</b>\n\n' + (e.stack || '');
    document.body.appendChild(d);
  }
  if (document.body) { showErr(); } else { document.addEventListener('DOMContentLoaded', showErr); }
}
</script>

<div id="lessonTooltip" class="lesson-tooltip" style="display:none;"></div>


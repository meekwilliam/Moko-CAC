  function openHelpSheet() {
    var html = '<div style="padding-top:10px;">' +
      '<h3 style="font-family:\'Quicksand\',sans-serif; margin-bottom:12px;">Help & Support</h3>' +
      '<div style="display:flex; flex-direction:column; gap:12px;">' +
        '<div style="padding:14px; background:var(--bg-app); border-radius:12px;">' +

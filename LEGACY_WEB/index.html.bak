      '<button class="btn-primary full" style="margin-top:20px;" id="btnCloseHelp">Close</button>' +
    '</div>';
    BottomSheetManager.open(html);
    document.getElementById('btnCloseHelp').addEventListener('click', function() {
      BottomSheetManager.close();
    });
  }


  function updateDashboardMessage() {
    var hour = new Date().getHours();
    var greeting = hour < 12 ? 'Good morning,' : hour < 18 ? 'Good afternoon,' : 'Good evening,';
    var greetEl = document.getElementById('dashGreeting');
    if (greetEl) greetEl.textContent = greeting;

    var subEl = document.getElementById('dashSub');
    if (subEl) {
      subEl.textContent = 'Keep your skin game strong';
    }
  }

  /* ---------- Onboarding Quiz Logic ---------- */


  /* ---------- Daily Limit Modal & Unblur Management ---------- */
  var dailyLimitTimerInterval = null;

  function updateDailyLimitCountdown() {
    var now = new Date();
    var midnight = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1, 0, 0, 0);
    var diff = midnight - now;
    if (diff <= 0) {
      var modal = document.getElementById('paywallModal');
      if (modal) modal.classList.remove('active');
      if (dailyLimitTimerInterval) {
        clearInterval(dailyLimitTimerInterval);
        dailyLimitTimerInterval = null;
      }
      return;
    }
    var hours = Math.floor(diff / (1000 * 60 * 60));
    var minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
    var seconds = Math.floor((diff % (1000 * 60)) / 1000);
    
    var timerEl = document.getElementById('dailyLimitTimer');
    if (timerEl) {
      timerEl.textContent = (hours < 10 ? "0" : "") + hours + "h " + 
                            (minutes < 10 ? "0" : "") + minutes + "m " + 
                            (seconds < 10 ? "0" : "") + seconds + "s";
    }
  }

  var SubscriptionManager = {
    isSubscribed: function() {
      return true; // Unconditionally return true so no other components restrict access
    },
    
    setSubscribed: function(val) {},
    
    applySubscriptionUI: function() {
      // Remove all blurs unconditionally!
      var progressContentPad = document.querySelector('#screen-progress .content-pad');
      if (progressContentPad) {
        var lockedCards = progressContentPad.querySelectorAll('.card');
        lockedCards.forEach(function(card) {
          card.classList.remove('blurred-content');
          SubscriptionManager.removeLockBadgeOverlay(card);
        });
      }
    },
    
    addLockBadgeOverlay: function(containerEl, message) {},
    
    removeLockBadgeOverlay: function(containerEl) {
      var overlay = containerEl.querySelector('.locked-badge-overlay');
      if (overlay) {
        overlay.remove();
      }
    },
    
    showDailyLimitModal: function() {
      var modal = document.getElementById('paywallModal');
      if (modal) {
        modal.classList.add('active');
      }
      
      if (dailyLimitTimerInterval) clearInterval(dailyLimitTimerInterval);
      updateDailyLimitCountdown();
      dailyLimitTimerInterval = setInterval(updateDailyLimitCountdown, 1000);
    },
    
    hidePaywall: function() {
      var modal = document.getElementById('paywallModal');
      if (modal) {
        modal.classList.remove('active');
      }
      if (dailyLimitTimerInterval) {
        clearInterval(dailyLimitTimerInterval);
        dailyLimitTimerInterval = null;
      }
    }
  };
  
  window.SubscriptionManager = SubscriptionManager;

  // Splash screen buttons
  var btnGetStarted = document.getElementById('btnGetStarted');
  if (btnGetStarted) {
    btnGetStarted.addEventListener('click', function() {
      navigate('screen-signup', 'forward');
    });
  }

  // Daily Limit Modal UI Bindings
  var closeXBtn = document.getElementById('btnPaywallCloseX');
  if (closeXBtn) {
    closeXBtn.addEventListener('click', function() {
      SubscriptionManager.hidePaywall();
    });
  }

  var gotItBtn = document.getElementById('btnGotItDailyLimit');
  if (gotItBtn) {
    gotItBtn.addEventListener('click', function() {
      SubscriptionManager.hidePaywall();
    });
  }


  // Follow system theme changes when pref is 'system'
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function() {
    if ((localStorage.getItem('glowo_theme') || 'system') === 'system') {
      if (window._applyTheme) window._applyTheme('system');
    }
  });

  // Initialize subscription UI state on startup
  SubscriptionManager.applySubscriptionUI();

  BottomSheetManager.init();
  PullToRefresh.init();
  initDashboard();

  // Populate animated splash screen mascot (loading screen)
  var splashMascotEl = document.getElementById('splashMascot');
  if (splashMascotEl) {
    splashMascotEl.innerHTML = mascot('happy');
  }

  // Populate welcome screen mascot
  var splashMascotWrap = document.getElementById('splashMascotWrap');
  if (splashMascotWrap) {
    splashMascotWrap.innerHTML = mascot('happy');
  }

  // ── One-time curriculum migrations ──
  // These remap saved node numbers after curriculum restructures. They MUST run at
  // most once each, in order. The version is stored as a monotonic integer: a
  // migration only runs if the stored version is below its target, and we write the
  // final version at the end. (Previously each guard checked for one exact version
  // string, so once a later migration bumped the version, the earlier guard no
  // longer matched and re-ran on every load, corrupting progress each time.)
  (function migrateCurriculum() {
    try {
      var ver = parseInt(localStorage.getItem('glowo_curriculum_version') || '1', 10);
      if (isNaN(ver)) ver = 1;
      var loadProg = function() { try { return JSON.parse(localStorage.getItem('glowo_lesson_progress') || 'null'); } catch (e) { return null; } };
      var loadIP   = function() { try { return JSON.parse(localStorage.getItem('glowo_lesson_inprogress') || 'null'); } catch (e) { return null; } };

      // v1 -> v2: Welcome Quiz unit inserted at front; every node shifted up by 2.
      if (ver < 2) {
        var prog = loadProg();
        if (prog && Array.isArray(prog.completed)) {
          prog.completed = prog.completed.map(function(n) { return n + 2; });
          localStorage.setItem('glowo_lesson_progress', JSON.stringify(prog));
        }
        var ip = loadIP();
        if (ip && typeof ip.node === 'number') {
          ip.node = ip.node + 2;
          localStorage.setItem('glowo_lesson_inprogress', JSON.stringify(ip));
        }
        ver = 2;
      }

      // v2 -> v3: lessons re-spread across 9 sections; remap old nodes to new slots.
      if (ver < 3) {
        var MAP = {1:1,2:2,3:6,4:7,5:8,6:9,7:11,8:12,9:13,10:14,11:16,12:17,13:18,14:21,15:22,16:23,17:26,18:27,19:28,20:31,21:32,22:33,23:36,24:37,25:38,26:41,27:42};
        var prog3 = loadProg();
        if (prog3 && Array.isArray(prog3.completed)) {
          prog3.completed = prog3.completed.map(function(n) { return MAP[n] || n; });
          localStorage.setItem('glowo_lesson_progress', JSON.stringify(prog3));
        }
        var ip3 = loadIP();
        if (ip3 && typeof ip3.node === 'number') {
          ip3.node = MAP[ip3.node] || ip3.node;
          localStorage.setItem('glowo_lesson_inprogress', JSON.stringify(ip3));
        }
        ver = 3;
      }

      localStorage.setItem('glowo_curriculum_version', String(ver));
    } catch (e) { /* non-fatal: leave progress as-is */ }
  })();

  var splashSeen = localStorage.getItem('glowo_splash_seen') === 'true';
  if (!splashSeen) {
    navigate('screen-splash', 'fade');
  } else {
    // Primary launch destination is the Path / Learning Map, not the Home dashboard.
    // renderProgressScreen() needs LessonEngine, which is defined later in this script,
    // so defer until the whole script has parsed.
    var bootToPath = function() {
      navigate('screen-progress', 'fade');
      if (typeof renderProgressScreen === 'function') renderProgressScreen();
    };
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bootToPath);
    } else {
      bootToPath();
    }
  }

  // Fade out splash loading screen once initial navigation completes
  setTimeout(function() {
    var splashLoader = document.getElementById('appSplashLoader');
    if (splashLoader) {
      splashLoader.classList.add('fade-out');
      setTimeout(function() {
        splashLoader.remove();
      }, 500);
    }
  }, 800);

  /* ---------- Service Worker Registration ---------- */
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', function() {
      navigator.serviceWorker.register('./sw.js')
        .then(function(reg) {
          // service worker registered
        })
        .catch(function(err) {
          console.warn('Service Worker registration failed:', err);
        });
    });
  }
/* ---------- Curriculum v3 — 45 nodes, 5 per unit ---------- */

/* ── Welcome Unit: nodes 1-5 ── */
var WELCOME_DATA = [
  {
    node: 1,
    title: "The Science of Hydration",
    feature_promo: "Your <b>Hydration Tracker</b> is on your Home Screen. Go log your first glasses of water to start building your streak!",
    screens: [
      { type: 'intro', title: 'The Science of Hydration',
        text: "Hydration starts from within, but topicals seal the deal. If your body is dehydrated your skin barrier suffers, but <b>humectants and moisturizers</b> fix surface dryness faster than a glass of water ever could." },
      { type: 'true_false',
        question: "Drinking enough water helps keep your skin barrier balanced and plump.",
        correct: true,
        explanation: "Water keeps skin cells full and the barrier working properly. <b>Hydration from within</b> is step one of healthy skin." },
      { type: 'multiple_choice',
        question: "What happens when skin doesn't get enough water?",
        options: ["It produces MORE oil to compensate", "It stops producing oil entirely", "Nothing changes"],
        correct: 0,
        wrong_explanations: [null, "Skin never fully stops oil production. A dry surface can actually push oil UP.", "Dehydration does change the skin. It can lead to dullness and a weaker barrier."],
        explanation: "When the surface lacks water, oil glands can <b>ramp up</b> to compensate, which may trigger breakouts." },
      { type: 'matching',
        question: "Match each state to what it does to your skin:",
        pairs: [["Dehydrated skin", "Looks dull and feels tight"], ["Hydrated skin", "Stays plump and balanced"], ["Topical humectants", "Draw water into the skin's surface"]] },
      { type: 'fill_blank',
        question: "A popular daily hydration goal many people aim for is [___] glasses of water.",
        options: ["8", "3", "20"],
        correct: 0,
        wrong_explanations: [null, "3 glasses is on the low side for most adults' daily needs.", "20 glasses a day is far more than the body needs."],
        explanation: "The <b>8-glass goal</b> is a popular rule of thumb, not a magic number. Staying generally hydrated supports your whole body, skin included." },
      { type: 'multiple_choice',
        question: "Which is a common sign that skin is dehydrated?",
        options: ["A rosy, bouncy glow", "Tightness, dullness, and flaking", "Smaller pores"],
        correct: 1,
        explanation: "Dehydrated skin often feels <b>tight and looks dull</b>, sometimes with fine flaking. Even if it's also oily." },
      { type: 'true_false',
        question: "Oily skin can still be dehydrated at the same time.",
        correct: true,
        explanation: "<b>Oil is not water.</b> Skin can pump out oil while still lacking the water it needs. A very common combination." },
      { type: 'spot_mistake',
        scenario: "Sam has oily, breakout-prone skin. Their dermatologist says to drink more water, but Sam decides to switch to a stronger face wash instead to cut the oil.",
        question: "What is the mistake in Sam's reasoning?",
        options: ["Visiting a dermatologist", "Using a stronger face wash instead of addressing dehydration", "Having oily skin"],
        correct: 1,
        wrong_explanations: ["Visiting a dermatologist is always a smart move!", null, "Having oily skin isn't a mistake. It's a skin type."],
        explanation: "A stronger wash strips more oil, telling the skin to produce even MORE. The better fix is a gentler routine with a <b>humectant moisturizer</b> to support the barrier." },
      { type: 'multiple_choice',
        question: "Besides drinking water, which habit helps skin hold onto hydration?",
        options: ["Taking long, very hot showers", "Using a humectant moisturizer like hyaluronic acid", "Skipping moisturizer to 'let skin breathe'"],
        correct: 1,
        wrong_explanations: ["Hot water strips the barrier and worsens dehydration.", null, "Skin doesn't 'breathe'. Skipping moisturizer lets water escape."],
        explanation: "<b>Humectants</b> like hyaluronic acid pull water into the skin and help hold it there. Hydration from the outside in." },
      { type: 'fill_blank_multi',
        template: "Dehydrated skin overproduces [__1__], so the real fix is more [__2__], not harsher cleansing.",
        blanks: [
          { options: ["oil", "water", "collagen"], correct: 0 },
          { options: ["hydration", "scrubbing", "makeup"], correct: 0 }
        ],
        explanation: "Excess <b>oil</b> can be the skin overcompensating for a dry surface. Supporting <b>hydration</b>, especially with topicals, helps the barrier settle." },
      { type: 'true_false',
        question: "Drinking water is the ONLY thing that affects your skin's hydration.",
        correct: false,
        explanation: "Topical <b>humectants, moisturizers, climate, and hot water</b> all affect hydration too. Water intake is just the foundation." },
      { type: 'multiple_choice',
        question: "Best approach for skin that's oily but also dehydrated?",
        options: ["Strip all oil with strong astringents", "Hydrate with a lightweight gel and drink more water", "Skip moisturizer completely"],
        correct: 1,
        explanation: "Calm oil by fixing the root cause: <b>add water-based hydration</b> and a light gel moisturizer so skin stops overcompensating." }
    ]

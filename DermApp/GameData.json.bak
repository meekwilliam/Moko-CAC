 "legal": {
  "privacy": {
   "title": "Privacy Policy",
   "date": "Last Updated: June 24, 2026",
   "sections": [
    {
     "heading": "1. Data Collection & Storage",
     "body": "This application operates strictly on a \"local-first\" architecture. All application states, learning progress, score logs, streak calendars, daily quest data, and checklist metrics are stored locally and exclusively inside the sandboxed hardware storage of your individual physical device. No personal identifiable data, biometric profiles, account credentials, or network logs are collected, stored, tracked, or transmitted by this software or its developers."
    },
    {
     "heading": "2. Third-Party Disclosures",
     "body": "We do not utilize remote server networks, cloud database buckets, advertising analytics, or user behavior tracking pixels. No data is harvested, shared, or sold to third-party entities."
    },
    {
     "heading": "3. Your Rights & Purging Data",
     "body": "Because all application states reside entirely on your personal physical hardware, you maintain total ownership of your information. Deleting the application from your device permanently purges all stored statistics, records, and history from your system memory."
    },
    {
     "heading": "1. Educational Purpose Only",
     "body": "This application is designed solely as an interactive textbook simulator and gamified reference resource concerning general skincare hygiene, daily cosmetic habits, and standard cosmetic ingredient science."
    },
    {
     "heading": "2. No Medical Advice or Diagnosis",
     "body": ""
    }
   ]
  },
  "terms": {
   "title": "Terms of Service / Legal Disclaimer",
   "date": "Last Updated: June 24, 2026",
   "sections": [
    {
     "heading": "1. Educational Purpose Only",
     "body": "This application is designed solely as an interactive textbook simulator and gamified reference resource concerning general skincare hygiene, daily cosmetic habits, and standard cosmetic ingredient science."
    },
    {
     "heading": "2. No Medical Advice or Diagnosis",
     "body": "<strong>THE MATERIAL PRESENTED WITHIN THIS SOFTWARE DOES NOT CONSTITUTE MEDICAL ADVICE, CLINICAL DIAGNOSIS, PROGNOSIS, OR PERSONALIZED MEDICAL TREATMENT PLANNING.</strong> This software does not analyze, diagnose, prevent, or treat specific medical or pathological dermatological conditions. The content should never be used as a substitute for, or replacement of, professional medical advice, consultation, or treatment from a certified dermatologist, doctor, or healthcare provider."
    },
    {
     "heading": "3. Complete Absolution & Limitation of Liability",
     "body": "<strong>BY USING THIS APPLICATION, YOU EXPLICITLY AGREE THAT THE DEVELOPERS AND OWNERS ASSUME ABSOLUTELY ZERO LIABILITY AND NO LEGAL RESPONSIBILITY FOR ANY INDEPENDENT REAL-WORLD DECISIONS MADE, ACTIONS TAKEN, SKINCARE HYGIENE ADJUSTMENTS ATTEMPTED, OR TOPICAL COSMETIC PRODUCTS PURCHASED BY YOU BASED UPON THE GENERAL INFORMATION LEARNED WITHIN THE GAME LOOPS.</strong>"
    }
   ]

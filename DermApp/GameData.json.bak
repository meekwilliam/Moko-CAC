     ],
     "explanation": "A <b>prompt, gentle cleanse</b> after sweating removes the sweat and bacteria behind workout breakouts."
    },
    {
     "type": "true_false",
     "question": "Exercise helps skin overall, as long as you manage sweat and makeup wisely.",
     "correct": true,
     "explanation": "The <b>circulation benefits</b> are real. Just cleanse off sweat and skip heavy makeup during workouts."
